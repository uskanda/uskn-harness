# Defaults for the limits of bin/uskn-loop (openspec: loop-run, loop-criteria). An environment variable named
# USKN_LOOP_<NAME> overrides <NAME>. Money is the estimate claude -p reports as total_cost_usd.
ROUNDS=5
PR_BUDGET_USD=40
IMPL_BUDGET_USD=10
IMPL_MINUTES=60
AUDIT_BUDGET_USD=3
AUDIT_MINUTES=20
VERIFY_MINUTES=30
