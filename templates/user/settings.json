{
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 30,
  "effortLevel": "xhigh",
  "env": {
    "IMPECCABLE_NO_STALENESS_CHECK": "1"
  },
  "includeCoAuthoredBy": true,
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "permissions": {
    "additionalDirectories": [
      "/tmp"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(glab auth *)",
      "Bash(glab variable *)",
      "Bash(glab api *)",
      "Bash(glab ci *)",
      "Bash(glab issue *)",
      "Bash(glab repo *)",
      "Bash(ls -la)",
      "Bash(bash -n *)",
      "Bash(bash --version)",
      "Bash(claude --version)",
      "WebSearch",
      "Bash(grep -iE *)",
      "Bash(command -v *)",
      "Bash(openspec --help)",
      "Bash(openspec --version)",
      "Bash(openspec show *)",
      "Bash(openspec list *)",
      "Bash(openspec new *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(openspec archive *)",
      "Bash(openspec validate *)",
      "Read(//etc/**)",
      "Read(//tmp/**)"
    ]
  },
  "theme": "auto",
  "tui": "fullscreen",
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/.npm",
        "~/.local/state"
      ],
      "denyWrite": [
        "~/.local/state/uskn-harness"
      ]
    }
  }
}
