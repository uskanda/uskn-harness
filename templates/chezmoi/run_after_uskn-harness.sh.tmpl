{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
# Install the uskn harness when it is missing, then sync it, on every `chezmoi apply` (openspec: machine-bootstrap).
# run_after_: the dotfiles' own files and their run_onchange_before_ cleanup land first, so sync can link into the
# paths they freed. Copied from uskn-harness/templates/chezmoi/; the logic lives in `uskn-harness sync`.
set -euo pipefail
# chezmoi exports CHEZMOI_DEST_DIR; honoring it keeps a --destination test run away from the real home.
export HOME="${CHEZMOI_DEST_DIR:-$HOME}"
H="$HOME/.local/share/uskn-harness"
command -v git >/dev/null || { echo "uskn-harness: git is required" >&2; exit 1; }
if [ ! -x "$HOME/.local/bin/mise" ] && ! command -v mise >/dev/null; then
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi
# The dev checkout: the first line of ~/.config/uskn-harness/dev-checkout (an absolute path, or one starting with ~),
# else ~/repos/uskn-harness. One plain line, since this runs before jq exists.
DEV="$HOME/repos/uskn-harness"
if [ -f "$HOME/.config/uskn-harness/dev-checkout" ]; then
  line=""
  IFS= read -r line < "$HOME/.config/uskn-harness/dev-checkout" || true
  line="${line%$'\r'}"
  case "$line" in
    \~) DEV="$HOME" ;;
    \~/*) DEV="$HOME/${line#\~/}" ;;
    /*) DEV="$line" ;;
  esac
fi
if [ ! -e "$H" ]; then
  mkdir -p "$(dirname "$H")"
  if [ -d "$DEV/.git" ]; then ln -s "$DEV" "$H"
  else git clone --quiet https://github.com/uskanda/uskn-harness.git "$H" || { echo "uskn-harness: clone failed; the next chezmoi apply (or uskn-harness sync) tries again" >&2; exit 1; }; fi
fi
exec "$H/bin/uskn-harness" sync
{{- end }}
