#!/usr/bin/env bash
# uskn-harness: install, update, and check the harness on this machine.
#
#   uskn-harness sync [--dry-run] [--remove]   idempotent install / update (`init` is an alias)
#   uskn-harness doctor                        report the state; exit 1 when something is broken
#   uskn-harness onboard-check [dir]           report what a product repo still needs (read-only, always exit 0)
#
# What sync does (openspec: harness-sync)
#   1. stable path      ~/.local/share/uskn-harness -> this checkout (or a managed clone)
#   2. runtime          mise, global node + jq, then every deps.json cli with global:true at its pinned version
#   3. executable       ~/.local/bin/uskn-harness -> bin/uskn-harness
#   4. own skills       ~/.claude/skills/<name> -> skills/**/<name>   (existing real dirs are left alone)
#   5. plugin           ~/.claude/skills/uskn-harness -> plugins/uskn-harness
#   5b. schema          ~/.local/share/openspec/schemas/uskn -> schemas/uskn (grilling-first workflow)
#   6. third-party      deps.json skills with mode=reference, installed only when missing
#   6b. sessions repo   ~/.ai-sessions cloned from deps.json repos.sessions.url (journals)
#   7. openspec         Claude skills/commands generated by `openspec init`, copied to the user layer
#   8. user layer       ~/.claude/CLAUDE.md from templates/user/CLAUDE.md (only if marked as managed)
#
# Environment
#   USKN_HARNESS_DIR       checkout to install from (default: the checkout this script lives in)
#   CLAUDE_CONFIG_DIR      Claude Code config dir (default ~/.claude)
#   USKN_HARNESS_STUB_NET  =1: record network / runtime steps in USKN_HARNESS_STUB_LOG instead of running them
set -uo pipefail

STABLE="$HOME/.local/share/uskn-harness"
BIN_LINK="$HOME/.local/bin/uskn-harness"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SKILLS_DIR="$CLAUDE_DIR/skills"
COMMANDS_DIR="$CLAUDE_DIR/commands"
SCHEMA_LINK="${XDG_DATA_HOME:-$HOME/.local/share}/openspec/schemas/uskn"
SESSIONS_DIR="$HOME/.ai-sessions"
MARKER="managed by uskn-harness"
MARKER_FILE=".uskn-harness-managed"
export MISE_YES=1

DRY=0 REMOVE=0 FAILS=0 WARNS=0 CHANGED=0 HARNESS=""

usage() { sed -n '2,21p' "$0"; }
say() { printf '%-9s %s\n' "$1" "$2"; }
note() {
  case "$1" in
    fail) FAILS=$((FAILS + 1)) ;;
    warn | conflict) WARNS=$((WARNS + 1)) ;;
    created | updated | removed) CHANGED=$((CHANGED + 1)) ;;
  esac
  say "$1" "$2"
}
stub() { [ "${USKN_HARNESS_STUB_NET:-0}" = 1 ]; }
have() { command -v "$1" >/dev/null 2>&1; }

realpath_f() { # fully resolved path, or failure when the target does not exist
  [ -e "$1" ] || return 1
  if have realpath; then realpath "$1"; else python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; fi
}
inside_harness() { case "$1" in "$HARNESS" | "$HARNESS"/*) return 0 ;; *) return 1 ;; esac; }

resolve_harness_dir() {
  local d
  if [ -n "${USKN_HARNESS_DIR:-}" ]; then d="$USKN_HARNESS_DIR"
  else d="$(dirname "$(realpath_f "$0")")/.."; fi
  [ -f "$d/deps.json" ] || { echo "not a harness checkout: $d (deps.json missing)" >&2; exit 2; }
  HARNESS="$(cd "$d" && pwd -P)"
}

deps_get() { # jq path, default
  if have jq; then jq -r "$1 // empty" "$HARNESS/deps.json" 2>/dev/null | grep . || echo "$2"; else echo "$2"; fi
}

# ------------------------------------------------------------ write primitives
# Every filesystem change goes through do_link / do_relink / do_copy / do_rm so --dry-run has one choke point.
do_link()   { if [ "$DRY" = 1 ]; then say plan "link $2 -> $1"; return 1; fi; mkdir -p "$(dirname "$2")" && ln -s "$1" "$2"; }
do_relink() { if [ "$DRY" = 1 ]; then say plan "relink $2 -> $1"; return 1; fi; rm -f "$2" && ln -s "$1" "$2"; }
do_copy()   { if [ "$DRY" = 1 ]; then say plan "copy $1 -> $2"; return 1; fi; mkdir -p "$(dirname "$2")" && cp "$1" "$2"; }
do_rm()     { if [ "$DRY" = 1 ]; then say plan "remove $1"; return 1; fi; rm -rf "$1"; }
# Network or runtime steps: logged under the stub, planned under --dry-run, run otherwise.
run_step() { # label, command...
  local label="$1"; shift
  if [ "$DRY" = 1 ]; then say plan "$label: $*"; return 1; fi
  if stub; then printf '%s\n' "$*" >>"${USKN_HARNESS_STUB_LOG:-/dev/null}"; say stub "$label"; return 1; fi
  if "$@" </dev/null; then return 0; else note fail "$label ($*)"; return 1; fi
}

# ------------------------------------------------------------------- links
# link_status target source -> ok | missing | update | conflict-real | conflict-foreign
link_status() {
  local t="$1" s="$2" real
  if [ -L "$t" ]; then
    real="$(realpath_f "$t" 2>/dev/null || true)"
    if [ -n "$real" ] && [ "$real" = "$(realpath_f "$s")" ]; then echo ok
    elif [ -z "$real" ]; then echo update
    elif inside_harness "$real"; then echo update
    else echo conflict-foreign; fi
  elif [ -e "$t" ]; then echo conflict-real
  else echo missing; fi
}
ensure_link() { # target source label
  local t="$1" s="$2" label="$3"
  case "$(link_status "$t" "$s")" in
    ok) note ok "$label" ;;
    missing) do_link "$s" "$t" && note created "$label -> $s" ;;
    update) do_relink "$s" "$t" && note updated "$label -> $s" ;;
    conflict-real) note conflict "$label: $t exists and is not a symlink (left untouched)" ;;
    conflict-foreign) note conflict "$label: $t points outside the harness ($(readlink "$t"))" ;;
  esac
}
remove_link() { # target label: remove only symlinks that point into the harness (or dangle)
  local t="$1" label="$2" real
  [ -L "$t" ] || return 0
  real="$(realpath_f "$t" 2>/dev/null || true)"
  if [ -z "$real" ] || inside_harness "$real"; then do_rm "$t" && note removed "$label"; fi
}

own_skills() { find "$HARNESS/skills" -mindepth 2 -maxdepth 3 -name SKILL.md 2>/dev/null | sed 's#/SKILL.md$##' | sort; }
check_duplicates() {
  local dup
  dup="$(own_skills | while read -r d; do basename "$d"; done | sort | uniq -d)"
  [ -z "$dup" ] || { echo "duplicate skill names under skills/: $dup" >&2; exit 2; }
  own_skills | while read -r d; do [ "$(basename "$d")" != uskn-harness ] || { echo "skill name uskn-harness is reserved for the plugin" >&2; exit 2; }; done
}

# --------------------------------------------------------------- managed copies
is_managed_file() { [ -f "$1" ] && head -n 1 "$1" | grep -q "$MARKER"; }
ensure_managed_file() { # src dest label
  local s="$1" d="$2" label="$3"
  if [ ! -e "$d" ] && [ ! -L "$d" ]; then do_copy "$s" "$d" && note created "$label"
  elif [ -L "$d" ]; then note conflict "$label: $d is a symlink (left untouched)"
  elif is_managed_file "$d"; then
    if cmp -s "$s" "$d"; then note ok "$label"; else do_copy "$s" "$d" && note updated "$label"; fi
  else note conflict "$label: $d exists without the '$MARKER' marker (left untouched)"; fi
}
ensure_managed_dir() { # src-dir dest-dir label
  local s="$1" d="$2" label="$3"
  if [ ! -e "$d" ] && [ ! -L "$d" ]; then
    if [ "$DRY" = 1 ]; then say plan "copy $s -> $d"; else mkdir -p "$(dirname "$d")" && cp -R "$s" "$d" && : >"$d/$MARKER_FILE" && note created "$label"; fi
  elif [ -L "$d" ]; then note conflict "$label: $d is a symlink (left untouched)"
  elif [ -f "$d/$MARKER_FILE" ]; then
    if diff -rq -x "$MARKER_FILE" "$s" "$d" >/dev/null 2>&1; then note ok "$label"
    elif [ "$DRY" = 1 ]; then say plan "refresh $d"
    else rm -rf "$d" && cp -R "$s" "$d" && : >"$d/$MARKER_FILE" && note updated "$label"; fi
  else note conflict "$label: $d exists without $MARKER_FILE (left untouched)"; fi
}

# ------------------------------------------------------------------ runtime
mise_bin() { if have mise; then command -v mise; else echo "$HOME/.local/bin/mise"; fi; }
ensure_runtime() {
  local node_ver mise
  node_ver="$(deps_get '.runtimes.node.version' 24)"
  if [ -x "$(mise_bin)" ]; then note ok "mise ($(mise_bin))"
  else run_step "install mise" bash -c "curl -fsSL https://mise.run | MISE_INSTALL_PATH='$HOME/.local/bin/mise' sh" && note created "mise -> ~/.local/bin/mise"; fi
  mise="$(mise_bin)"
  if stub || [ "$DRY" = 1 ]; then run_step "mise global node" "$mise" use -g "node@$node_ver"
  elif (cd / && "$mise" exec -- node --version 2>/dev/null) | grep -q "^v$node_ver\."; then note ok "node $node_ver (mise global)"
  else run_step "mise global node" "$mise" use -g "node@$node_ver" && note created "node $node_ver (mise global)"; fi
  if have jq; then note ok "jq ($(command -v jq))"
  else run_step "mise global jq" "$mise" use -g "jq@$(deps_get '.runtimes.jq.version' 1.7)" && note created "jq (mise global)"; fi
}

# ---------------------------------------------------------- pinned npm globals
# npm_root: where `npm install -g` puts packages. USKN_NPM_ROOT overrides it (tests); fails under the stub.
npm_root() {
  local r
  if [ -n "${USKN_NPM_ROOT:-}" ]; then printf '%s' "$USKN_NPM_ROOT"; return 0; fi
  stub && return 1
  r="$( (cd / && "$(mise_bin)" exec -- npm root -g 2>/dev/null) | tail -n 1 )"
  [ -n "$r" ] || return 1
  printf '%s' "$r"
}
pkg_version() { # <npm root> <package>: the installed version, or failure
  local f="$1/$2/package.json"
  [ -f "$f" ] || return 1
  if have jq; then jq -r '.version // empty' "$f"; else sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n 1; fi
}
# npm_pins: one line per cli with global:true -- key, install specs (pkg@ver ...), checks (pkg=ver ...)
npm_pins() {
  jq -r '.clis | to_entries[] | select(.value.global == true) |
    [ .key,
      ([ "\(.value.package)@\(.value.version)" ] + ((.value.bundle // {}) | to_entries | map("\(.key)@\(.value)")) | join(" ")),
      ([ "\(.value.package)=\(.value.version)" ] + ((.value.bundle // {}) | to_entries | map("\(.key)=\(.value)")) | join(" "))
    ] | @tsv' "$HARNESS/deps.json"
}
ensure_npm_globals() {
  have jq || { note warn "jq missing: pinned npm CLIs skipped"; return 0; }
  local key specs checks root c name want cur stale v installed=0
  root="$(npm_root || true)"
  while IFS=$'\t' read -r -u 3 key specs checks; do
    [ -n "$key" ] || continue
    stale=""
    if [ -z "$root" ]; then stale="not checked"
    else
      for c in $checks; do
        name="${c%=*}"; want="${c##*=}"
        cur="$(pkg_version "$root" "$name" 2>/dev/null || true)"
        [ "$cur" = "$want" ] || { stale="$name ${cur:-none} -> $want"; break; }
      done
    fi
    if [ -z "$stale" ]; then v="${checks%% *}"; note ok "$key ${v##*=}"
    else
      # shellcheck disable=SC2086
      run_step "npm global $key" "$(mise_bin)" exec -- npm install -g $specs && { note created "$key ($specs)"; installed=1; }
    fi
  done 3< <(npm_pins)
  [ "$installed" = 1 ] && run_step "mise reshim" "$(mise_bin)" reshim >/dev/null 2>&1
  return 0
}

ensure_third_party() {
  have jq || { note warn "jq missing: third-party skills skipped"; return 0; }
  local name install
  while IFS=$'\t' read -r -u 3 name install; do
    [ -n "$name" ] || continue
    if [ -e "$SKILLS_DIR/$name" ]; then note ok "third-party $name"
    else run_step "third-party $name" "$(mise_bin)" exec -- bash -c "$install" && note created "third-party $name"; fi
  done 3< <(jq -r '.skills | to_entries[] | select(.value.mode == "reference" and .value.install != null) | [.key, .value.install] | @tsv' "$HARNESS/deps.json")
}

ensure_sessions_repo() {
  local url; url="$(deps_get '.repos.sessions.url' '')"
  [ -n "$url" ] || { note warn "deps.json has no repos.sessions.url; sessions repo skipped"; return 0; }
  if [ -d "$SESSIONS_DIR/.git" ]; then note ok "sessions repo ($SESSIONS_DIR)"
  elif [ -e "$SESSIONS_DIR" ]; then note conflict "sessions repo: $SESSIONS_DIR exists but is not a git repository (left untouched)"
  else run_step "clone sessions repo" git clone --quiet "$url" "$SESSIONS_DIR" && note created "sessions repo -> $SESSIONS_DIR"; fi
}

ensure_openspec_user_layer() {
  if [ "$DRY" = 1 ]; then say plan "generate openspec Claude skills/commands into $SKILLS_DIR and $COMMANDS_DIR/opsx"; return 0; fi
  if stub; then printf '%s\n' "openspec-user-layer" >>"${USKN_HARNESS_STUB_LOG:-/dev/null}"; say stub "openspec user-layer skills"; return 0; fi
  local tmp d
  tmp="$(mktemp -d)"
  if ! (cd "$tmp" && "$(mise_bin)" exec -- openspec init --tools claude --language ja --no-animation >"$tmp/init.log" 2>&1); then
    note warn "openspec init failed in a temp dir; user-layer skills not refreshed ($(tail -n 1 "$tmp/init.log" 2>/dev/null))"; rm -rf "$tmp"; return 0
  fi
  for d in "$tmp"/.claude/skills/openspec-*; do [ -d "$d" ] && ensure_managed_dir "$d" "$SKILLS_DIR/$(basename "$d")" "openspec skill $(basename "$d")"; done
  [ -d "$tmp/.claude/commands/opsx" ] && ensure_managed_dir "$tmp/.claude/commands/opsx" "$COMMANDS_DIR/opsx" "openspec commands opsx"
  rm -rf "$tmp"
}

# ---------------------------------------------------------------- commands
cmd_sync() {
  check_duplicates
  local d name
  if [ "$REMOVE" = 1 ]; then
    for d in $(own_skills); do remove_link "$SKILLS_DIR/$(basename "$d")" "skill $(basename "$d")"; done
    remove_link "$SKILLS_DIR/uskn-harness" "plugin uskn-harness"
    remove_link "$SCHEMA_LINK" "openspec schema uskn"
    remove_link "$BIN_LINK" "executable"
    remove_link "$STABLE" "stable path"
    is_managed_file "$CLAUDE_DIR/CLAUDE.md" && do_rm "$CLAUDE_DIR/CLAUDE.md" && note removed "user CLAUDE.md"
    for d in "$SKILLS_DIR"/openspec-* "$COMMANDS_DIR/opsx"; do [ -f "$d/$MARKER_FILE" ] && do_rm "$d" && note removed "$(basename "$d")"; done
    say "done" "removed $CHANGED item(s)"; return 0
  fi
  say info "harness: $HARNESS"
  if [ -d "$STABLE" ] && [ ! -L "$STABLE" ] && [ "$(realpath_f "$STABLE")" = "$HARNESS" ]; then note ok "stable path (managed clone)"
  else ensure_link "$STABLE" "$HARNESS" "stable path"; fi
  ensure_runtime
  ensure_npm_globals
  ensure_link "$BIN_LINK" "$HARNESS/bin/uskn-harness" "executable"
  for d in $(own_skills); do name="$(basename "$d")"; ensure_link "$SKILLS_DIR/$name" "$d" "skill $name"; done
  ensure_link "$SKILLS_DIR/uskn-harness" "$HARNESS/plugins/uskn-harness" "plugin uskn-harness"
  ensure_link "$SCHEMA_LINK" "$HARNESS/schemas/uskn" "openspec schema uskn"
  ensure_third_party
  ensure_sessions_repo
  ensure_openspec_user_layer
  ensure_managed_file "$HARNESS/templates/user/CLAUDE.md" "$CLAUDE_DIR/CLAUDE.md" "user CLAUDE.md"
  say "done" "$CHANGED change(s), $WARNS warning(s)"
}

check_link() { # target source label  (doctor)
  case "$(link_status "$1" "$2")" in
    ok) note ok "$3" ;;
    missing) note warn "$3: missing (run uskn-harness sync)" ;;
    update) note warn "$3: stale symlink (run uskn-harness sync)" ;;
    conflict-real) note warn "$3: $1 is a real directory or file (chezmoi-managed copy? sync skips it)" ;;
    conflict-foreign) note fail "$3: $1 points outside the harness ($(readlink "$1"))" ;;
  esac
}
check_npm_globals() { # doctor: every pinned npm cli, with the installed version when it differs
  have jq || return 0
  local key specs checks root c name want cur bad v
  if ! root="$(npm_root)"; then say stub "pinned npm CLIs not checked"; return 0; fi
  while IFS=$'\t' read -r -u 3 key specs checks; do
    [ -n "$key" ] || continue
    bad=""
    for c in $checks; do
      name="${c%=*}"; want="${c##*=}"
      cur="$(pkg_version "$root" "$name" 2>/dev/null || true)"
      [ "$cur" = "$want" ] || bad="${bad:+$bad, }$name: have '${cur:-none}', want '$want'"
    done
    if [ -z "$bad" ]; then v="${checks%% *}"; note ok "$key ${v##*=}"; else note warn "$key ($bad)"; fi
  done 3< <(npm_pins)
}

cmd_doctor() {
  local d name mise
  say info "harness: $HARNESS"
  if [ -d "$STABLE" ] && [ ! -L "$STABLE" ] && [ "$(realpath_f "$STABLE")" = "$HARNESS" ]; then note ok "stable path (managed clone)"
  else check_link "$STABLE" "$HARNESS" "stable path"; fi
  if stub; then say stub "runtime checks skipped"
  else
    mise="$(mise_bin)"
    if [ -x "$mise" ]; then note ok "mise"; else note warn "mise missing"; fi
    if [ -x "$mise" ] && (cd / && "$mise" exec -- node --version >/dev/null 2>&1); then note ok "node ($(cd / && "$mise" exec -- node --version 2>/dev/null)) outside the checkout"; else note warn "node not resolvable through mise outside the checkout (run sync)"; fi
    if have jq; then note ok "jq"; else note warn "jq missing"; fi
  fi
  check_npm_globals
  check_link "$BIN_LINK" "$HARNESS/bin/uskn-harness" "executable"
  for d in $(own_skills); do name="$(basename "$d")"; check_link "$SKILLS_DIR/$name" "$d" "skill $name"; done
  check_link "$SKILLS_DIR/uskn-harness" "$HARNESS/plugins/uskn-harness" "plugin uskn-harness"
  check_link "$SCHEMA_LINK" "$HARNESS/schemas/uskn" "openspec schema uskn"
  if have claude && ! stub; then
    if claude plugin validate "$HARNESS/plugins/uskn-harness" >/dev/null 2>&1; then note ok "plugin validate"; else note fail "plugin validate (claude plugin validate $HARNESS/plugins/uskn-harness)"; fi
  fi
  if have jq; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      if [ -e "$SKILLS_DIR/$name" ]; then note ok "third-party $name"; else note warn "third-party $name missing (run sync)"; fi
    done < <(jq -r '.skills | to_entries[] | select(.value.mode == "reference" and .value.install != null) | .key' "$HARNESS/deps.json")
  fi
  for name in openspec-propose openspec-apply-change openspec-archive-change openspec-explore; do
    d="$SKILLS_DIR/$name"
    if [ -f "$d/$MARKER_FILE" ]; then note ok "openspec skill $name"
    elif [ -e "$d" ]; then note warn "openspec skill $name: present but not harness-managed (chezmoi copy?)"
    else note warn "openspec skill $name missing (run sync)"; fi
  done
  if [ -d "$SESSIONS_DIR/.git" ]; then note ok "sessions repo"; else note warn "sessions repo missing at $SESSIONS_DIR (run sync)"; fi
  if is_managed_file "$CLAUDE_DIR/CLAUDE.md"; then note ok "user CLAUDE.md"
  elif [ -e "$CLAUDE_DIR/CLAUDE.md" ]; then note warn "user CLAUDE.md exists without the marker (sync will not touch it)"
  else note warn "user CLAUDE.md missing (run sync)"; fi
  say "done" "$FAILS problem(s), $WARNS warning(s)"
  [ "$FAILS" -eq 0 ]
}

# ------------------------------------------------------------ onboard-check
# Read-only report on a product repository: what the harness expects there and what is missing.
# Never writes to the target and never touches the network; exit code is always 0 (openspec: onboard-check).
repo_has_ui() { # <dir>: a UI framework in package.json dependencies
  local f="$1/package.json"
  [ -f "$f" ] || return 1
  if have jq; then jq -e '((.dependencies // {}) + (.devDependencies // {})) | keys | any(. == ("react","react-native","expo","vue","svelte","next"))' "$f" >/dev/null 2>&1
  else grep -qE '"(react|react-native|expo|vue|svelte|next)"[[:space:]]*:' "$f"; fi
}
has_verify() { # <dir>: the verify convention, printed when found
  local d="$1" mk
  for mk in Makefile GNUmakefile; do
    [ -f "$d/$mk" ] && grep -qE '^verify[[:space:]]*:' "$d/$mk" && { printf 'make verify'; return 0; }
  done
  if [ -f "$d/package.json" ]; then
    if { have jq && jq -e '.scripts.verify' "$d/package.json" >/dev/null 2>&1; } || { ! have jq && grep -q '"verify"' "$d/package.json"; }; then
      [ -f "$d/pnpm-lock.yaml" ] && printf 'pnpm run verify' || printf 'npm run verify'
      return 0
    fi
  fi
  return 1
}
cmd_onboard_check() { # <dir>
  local d name cmd n
  d="$(realpath_f "${1:-.}" 2>/dev/null || printf '%s' "${1:-.}")"
  [ -d "$d" ] || { echo "not a directory: $d" >&2; exit 2; }
  say info "repo: $d"
  if [ -f "$d/AGENTS.md" ]; then note ok "AGENTS.md ($(wc -l < "$d/AGENTS.md") lines)"
  else note warn "AGENTS.md missing (the entry point for agents)"; fi
  if [ ! -f "$d/CLAUDE.md" ]; then note warn "CLAUDE.md missing (should be @AGENTS.md plus Claude-specific lines)"
  elif grep -q '@AGENTS.md' "$d/CLAUDE.md"; then note ok "CLAUDE.md -> @AGENTS.md"
  else note warn "CLAUDE.md does not reference @AGENTS.md (move the content to AGENTS.md)"; fi
  if [ ! -f "$d/openspec/config.yaml" ]; then note warn "openspec/ missing (run openspec init, then set schema: uskn)"
  elif grep -qE '^schema:[[:space:]]*uskn' "$d/openspec/config.yaml"; then note ok "openspec schema: uskn"
  else note warn "openspec/config.yaml does not set schema: uskn"; fi
  if cmd="$(has_verify "$d")"; then note ok "verify convention ($cmd)"
  else note warn "no verify convention (add a make verify target)"; fi
  if repo_has_ui "$d"; then
    if [ -f "$d/DESIGN.md" ]; then note ok "DESIGN.md"; else note warn "DESIGN.md missing (UI repo; copy templates/repo/DESIGN.md)"; fi
    if [ -f "$d/PRODUCT.md" ]; then note ok "PRODUCT.md"; else note warn "PRODUCT.md missing (UI repo; copy templates/repo/PRODUCT.md)"; fi
  fi
  n=0
  if [ -d "$d/.claude/skills" ]; then
    for name in "$d"/.claude/skills/*; do
      [ -e "$name" ] || continue
      name="$(basename "$name")"
      if [ -e "$SKILLS_DIR/$name" ]; then note warn "project skill $name shadows the user-layer skill of the same name"; n=$((n + 1)); fi
    done
    if [ "$n" -eq 0 ]; then note ok "project skills do not shadow user-layer skills"; fi
  fi
  say "done" "$WARNS item(s) still to do"
  return 0
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    -h | --help | help | "") usage; [ -n "$cmd" ] && exit 0 || exit 2 ;;
    sync | init | doctor | onboard-check) ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
  esac
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      --remove) REMOVE=1 ;;
      -*) echo "unknown option: $1" >&2; exit 2 ;;
      *) if [ "$cmd" = onboard-check ] && [ -z "$target" ]; then target="$1"; else echo "unexpected argument: $1" >&2; exit 2; fi ;;
    esac
    shift
  done
  resolve_harness_dir
  case "$cmd" in
    sync | init) cmd_sync ;;
    doctor) cmd_doctor ;;
    onboard-check) cmd_onboard_check "${target:-.}" ;;
  esac
}
[ "${USKN_HARNESS_SOURCED:-0}" = 1 ] || main "$@"
