#!/usr/bin/env bash
# uskn-harness: install, update, and check the harness on this machine.
#
#   uskn-harness sync [--dry-run] [--remove] [--no-pull]   idempotent install / update (`init` is an alias)
#   uskn-harness sync --tools [--dry-run]      steps 2 and 5b only: runtime, pinned CLIs, schema link (CI)
#   uskn-harness doctor                        report the state; exit 1 when something is broken
#   uskn-harness onboard-check [dir]           report what a product repo still needs (read-only, always exit 0)
#   uskn-harness print-settings                the composite of the settings fragments and the machine overlay that sync
#                                              merges into ~/.claude/settings.json, as JSON on stdout; writes nothing
#   uskn-harness install-shared [--dry-run] <dir>  the administrator installs node, jq, the pinned CLIs and the
#                                              third-party skills into <dir> for confined environments (see below)
#   uskn-harness sandbox-exclude <pattern>     run commands matching <pattern> outside the Claude Code sandbox on this
#                                              machine: add it to the overlay's sandbox.excludedCommands, then apply
#                                              the user settings (step 8) only
#   uskn-harness sandbox-exclude --list        the live patterns, each marked fragment, machine, or live
#   uskn-harness sandbox-exclude --remove <p>  take a machine pattern out again (fragment patterns need a pull request)
#   uskn-harness sandbox-allow-host <host>     let sandboxed commands on this machine reach <host>, such as one that
#                                              resolves to this machine's own address: add it to the overlay's
#                                              sandbox.network.allowedDomains, then apply the user settings (step 8)
#   uskn-harness sandbox-allow-host --list     the live hosts, each marked fragment, machine, or live
#   uskn-harness sandbox-allow-host --remove <host>  take a machine host out again
#
# What sync does (openspec: harness-sync)
#   0. update           git pull --ff-only in the checkout, then re-exec the new script (--no-pull skips it)
#   1. stable path      ~/.local/share/uskn-harness -> this checkout (or a managed clone)
#   2. runtime          mise, global node + jq, then every deps.json cli with global:true at its pinned version
#   3. executables      ~/.local/bin/uskn-harness -> bin/uskn-harness, ~/.local/bin/uskn-loop -> bin/uskn-loop
#   4. own skills       ~/.claude/skills/<name> -> skills/**/<name>   (real dirs left alone; dangling links pruned)
#   5. plugins          ~/.claude/skills/<name> -> plugins/<name>, for each dir with .claude-plugin/plugin.json
#   5a. notify commands ~/.local/bin/<command> -> plugins/uskn-notify/bin/<command>
#   Links into the harness (3, 4, 5, 5a, 5b) are relative and go through the stable path, e.g.
#   ~/.claude/skills/commit -> ../../.local/share/uskn-harness/skills/git/commit, so a copied ~/.claude keeps working
#   wherever the harness sits at the stable path. While the stable path is not this checkout, they are absolute.
#   5b. schema          ~/.local/share/openspec/schemas/uskn -> schemas/uskn (grilling-first workflow)
#   6. third-party      deps.json skills with `via`: the skills CLI at the pinned ref (again when its lock records
#                       another ref), Impeccable from its sha256-checked release asset, then its agents removed
#   6b. session state   hook state dirs under <state>/uskn-harness/sessions untouched for 30 days are removed
#   7. openspec         Claude commands (/opsx:*) generated by `openspec init`; old openspec-* skill copies removed
#   8. user settings    ~/.claude/settings.json: the fragments templates/user/settings.json, settings-<kind>.json and
#                       settings-<os>.json, then ~/.config/uskn-harness/settings.json, merged into it, never replacing
#                       it (openspec: user-settings)
#   9. user layer       ~/.claude/CLAUDE.md from templates/user/CLAUDE.md (only if marked as managed)
#   10. LaunchAgents    macOS: a notify LaunchAgent the user installed is installed again when its command changed
#   `sync --tools` runs 2 and 5b only; nothing under ~/.claude, no clone, no third-party skills (CI runners).
#   Exit status: 0; 1 when a step failed (the other steps still run); 2 for a usage error or a skill name clash.
#   A conflict or a failed checkout update is a warning and keeps 0.
#
# The confined environment (openspec: environment-kind, shared-tools)
#   A checkout with a root-owned .uskn-environment (lines kind=confined, tools=<dir>, secrets=<dir>) is a confined
#   environment; without one it is the admin environment. Only that file decides: no option or variable changes it.
#   The administrator puts the checkout and the marker in place and runs `install-shared <tools dir>`; the terminal
#   base then runs `sync --no-pull` as the confined user. That sync skips 0, installs nothing in 2 (it reports the tools
#   dir's installed.json against deps.json), leaves out the admin-only skills (metadata uskn-environment: admin), the
#   uskn-notify plugin, 5a and 10, links 6 to <tools>/skills/<name>, runs 7 with <tools>/bin/openspec, and in 8 merges
#   settings-confined.json and drops the overlay's keys that loosen the sandbox (each reported as a warn).
#   sandbox-exclude and sandbox-allow-host refuse there, except --list. doctor also checks the marker (owner uid 0, not
#   writable by the user), that the checkout and the tools dir are not writable, and that sandbox-exec exists (macOS).
#
# Environment
#   USKN_HARNESS_DIR       checkout to install from (default: the checkout this script lives in)
#   CLAUDE_CONFIG_DIR      Claude Code config dir (default ~/.claude)
#   USKN_STATE_DIR         the hooks' state dir, pruned by step 6b (default ${XDG_STATE_HOME:-~/.local/state}/uskn-harness)
#   XDG_STATE_HOME         where the skills CLI keeps its lock file (skills/.skill-lock.json; default ~/.agents/)
#   USKN_HARNESS_STUB_NET  =1: record network / runtime steps in USKN_HARNESS_STUB_LOG instead of running them
#   USKN_HARNESS_STUB_FAIL under the stub, a glob on step labels that makes those steps fail (tests)
#   USKN_HARNESS_REEXEC    =1: set on the process `sync` re-executes after an update; stops it from looping
#   USKN_HARNESS_OS        the `uname -s` value the OS fragment, the LaunchAgent step and doctor see (tests)
#   USKN_MARKER_UID        the owner uid doctor expects of the environment marker (default 0; tests)
set -uo pipefail

STABLE="$HOME/.local/share/uskn-harness"
BIN_LINK="$HOME/.local/bin/uskn-harness"
LOOP_LINK="$HOME/.local/bin/uskn-loop"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SKILLS_DIR="$CLAUDE_DIR/skills"
COMMANDS_DIR="$CLAUDE_DIR/commands"
SCHEMA_LINK="${XDG_DATA_HOME:-$HOME/.local/share}/openspec/schemas/uskn"
# The hooks' state dir, computed as plugins/uskn-harness/hooks/scripts/lib/common.sh does.
STATE_DIR="${USKN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/uskn-harness}"
STATE_MAX_MIN=43200   # 30 days: a session dir untouched this long is removed by sync
MARKER="managed by uskn-harness"
MARKER_FILE=".uskn-harness-managed"
export MISE_YES=1

DRY=0 REMOVE=0 TOOLS=0 NO_PULL=0 FAILS=0 WARNS=0 CHANGED=0 HARNESS=""
ORIG_ARGV=()   # what main was called with, so an update can re-execute the new script with the same request

usage() { awk 'NR == 1 { next } /^#/ { print; next } { exit }' "$0"; }
say() { printf '%-9s %s\n' "$1" "$2"; }
note() {
  case "$1" in
    fail) FAILS=$((FAILS + 1)) ;;
    warn | conflict) WARNS=$((WARNS + 1)) ;;
    created | updated | removed) CHANGED=$((CHANGED + 1)) ;;
  esac
  say "$1" "$2"
}
stub() { [ "${USKN_HARNESS_STUB_NET:-0}" = 1 ]; }
have() { command -v "$1" >/dev/null 2>&1; }

realpath_f() { # fully resolved path, or failure when the target does not exist
  [ -e "$1" ] || return 1
  if have realpath; then realpath "$1"; else python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; fi
}
inside_harness() { case "$1" in "$HARNESS" | "$HARNESS"/*) return 0 ;; *) return 1 ;; esac; }

resolve_harness_dir() {
  local d
  if [ -n "${USKN_HARNESS_DIR:-}" ]; then d="$USKN_HARNESS_DIR"
  else d="$(dirname "$(realpath_f "$0")")/.."; fi
  [ -f "$d/deps.json" ] || { echo "not a harness checkout: $d (deps.json missing)" >&2; exit 2; }
  HARNESS="$(cd "$d" && pwd -P)"
}

# environment_read: the environment marker, $HARNESS/.uskn-environment, read with the read builtin only (jq may not
# exist yet), the way the hooks' lib/common.sh reads it (openspec: environment-kind). Sets ENV_KIND (admin |
# confined), ENV_TOOLS, ENV_SECRETS and ENV_MARKER (none | ok | invalid). No marker: admin. A marker whose kind is not
# confined, or that cannot be read, is invalid and counts as confined: whoever put it there meant to tighten. No
# argument, variable, or user-layer file changes the kind.
ENV_KIND=admin ENV_TOOLS="" ENV_SECRETS="" ENV_MARKER=none
environment_read() {
  local f="$HARNESS/.uskn-environment" line key kind=""
  ENV_KIND=admin ENV_TOOLS="" ENV_SECRETS="" ENV_MARKER=none
  [ -e "$f" ] || [ -L "$f" ] || return 0
  ENV_KIND=confined ENV_MARKER=invalid
  { [ -f "$f" ] && [ -r "$f" ]; } || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in '' | '#'*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    case "$key" in
      kind) kind="${line#*=}" ;;
      tools) ENV_TOOLS="${line#*=}" ;;
      secrets) ENV_SECRETS="${line#*=}" ;;
    esac
  done < "$f"
  [ "$kind" = confined ] && ENV_MARKER=ok
  return 0
}
confined() { [ "$ENV_KIND" = confined ]; }

deps_get() { # jq path, default
  if have jq; then jq -r "$1 // empty" "$HARNESS/deps.json" 2>/dev/null | grep . || echo "$2"; else echo "$2"; fi
}

# ------------------------------------------------------------ write primitives
# Every filesystem change goes through do_link / do_relink / do_copy / do_rm so --dry-run has one choke point.
do_link()   { if [ "$DRY" = 1 ]; then say plan "link $2 -> $1"; return 1; fi; mkdir -p "$(dirname "$2")" && ln -s "$1" "$2"; }
do_relink() { if [ "$DRY" = 1 ]; then say plan "relink $2 -> $1"; return 1; fi; rm -f "$2" && ln -s "$1" "$2"; }
do_copy()   { if [ "$DRY" = 1 ]; then say plan "copy $1 -> $2"; return 1; fi; mkdir -p "$(dirname "$2")" && cp "$1" "$2"; }
do_rm()     { if [ "$DRY" = 1 ]; then say plan "remove $1"; return 1; fi; rm -rf "$1"; }
# Network or runtime steps: logged under the stub, planned under --dry-run, run otherwise. A failure is a `fail`,
# which makes sync exit 1; with --soft it is a `warn` instead.
run_step() { # [--soft] label, command...
  local kind=fail label tail=""
  [ "$1" = --soft ] && { kind=warn; tail=" failed; continuing"; shift; }
  label="$1"; shift
  if [ "$DRY" = 1 ]; then say plan "$label: $*"; return 1; fi
  if stub; then
    printf '%s\n' "$*" >>"${USKN_HARNESS_STUB_LOG:-/dev/null}"
    # shellcheck disable=SC2053  # the right-hand side is a glob on purpose
    if [ -n "${USKN_HARNESS_STUB_FAIL:-}" ] && [[ "$label" == $USKN_HARNESS_STUB_FAIL ]]; then note "$kind" "$label ($*)$tail"; return 1; fi
    say stub "$label"; return 1
  fi
  if "$@" </dev/null; then return 0; else note "$kind" "$label ($*)$tail"; return 1; fi
}

# ------------------------------------------------------------------- links
# Links into the harness go through the stable path by a relative path, so a copy of ~/.claude next to a stable path
# (another HOME, a container) still resolves. Paths are physical: the kernel resolves a relative link from the
# physical directory it sits in.
phys_dir() { # a directory's physical path; the missing tail is kept as written
  local p="$1" rest="" d
  while [ ! -d "$p" ]; do rest="/$(basename "$p")$rest"; p="$(dirname "$p")"; done
  d="$(cd "$p" && pwd -P)"; [ "$d" = / ] && d=""
  printf '%s%s\n' "$d" "$rest"
}
relpath() { # from-dir to-path, both absolute and physical -> to-path relative to from-dir
  local common="$1" up=""
  while [ "$common" != / ]; do
    case "$2/" in "$common"/*) break ;; esac
    common="$(dirname "$common")"; up="../$up"
  done
  if [ "$common" = / ]; then printf '%s%s\n' "$up" "${2#/}"; else printf '%s%s\n' "$up" "${2#"$common"/}"; fi
}
fold_path() { # an absolute path with . and .. folded as text
  local IFS=/ part out=""
  set -f
  for part in $1; do
    case "$part" in '' | .) ;; ..) out="${out%/*}" ;; *) out="$out/$part" ;; esac
  done
  set +f
  printf '%s\n' "${out:-/}"
}
link_target_text() { # link -> the absolute path its text names, folded as text (works for a dangling link)
  local t; t="$(readlink "$1")"
  case "$t" in /*) ;; *) t="$(phys_dir "$(dirname "$1")")/$t" ;; esac
  fold_path "$t"
}
stable_phys() { printf '%s/%s\n' "$(phys_dir "$(dirname "$STABLE")")" "$(basename "$STABLE")"; }
stable_is_harness() { # the stable path resolves to this checkout (or, under --dry-run, sync is about to create it)
  [ "$(realpath_f "$STABLE" 2>/dev/null)" = "$HARNESS" ] && return 0
  [ "$DRY" = 1 ] && [ ! -e "$STABLE" ] && [ ! -L "$STABLE" ] && [ "$TOOLS" = 0 ]
}
link_text() { # target source -> what sync writes into the link: relative through the stable path, else the source
  case "$2" in
    "$HARNESS"/*) if stable_is_harness; then relpath "$(phys_dir "$(dirname "$1")")" "$(stable_phys)/${2#"$HARNESS"/}"; return; fi ;;
  esac
  printf '%s\n' "$2"
}
# link_status target source -> ok | missing | update | rewrite | conflict-real | conflict-foreign
# rewrite: the link resolves to the source but its text is not what sync writes (an absolute link from before).
link_status() {
  local t="$1" s="$2" real
  if [ -L "$t" ]; then
    real="$(realpath_f "$t" 2>/dev/null || true)"
    if [ -n "$real" ] && [ "$real" = "$(realpath_f "$s")" ]; then
      case "$s" in "$HARNESS"/*) [ "$(readlink "$t")" = "$(link_text "$t" "$s")" ] || { echo rewrite; return; } ;; esac
      echo ok
    elif [ -z "$real" ]; then echo update
    elif inside_harness "$real"; then echo update
    else echo conflict-foreign; fi
  elif [ -e "$t" ]; then echo conflict-real
  else echo missing; fi
}
ensure_link() { # target source label
  local t="$1" s="$2" label="$3"
  case "$(link_status "$t" "$s")" in
    ok) note ok "$label" ;;
    missing) do_link "$(link_text "$t" "$s")" "$t" && note created "$label -> $s" ;;
    update | rewrite) do_relink "$(link_text "$t" "$s")" "$t" && note updated "$label -> $s" ;;
    conflict-real) note conflict "$label: $t exists and is not a symlink (left untouched)" ;;
    conflict-foreign) note conflict "$label: $t points outside the harness ($(readlink "$t"))" ;;
  esac
}
remove_link() { # target label: remove only symlinks that point into the harness (or dangle)
  local t="$1" label="$2" real
  [ -L "$t" ] || return 0
  real="$(realpath_f "$t" 2>/dev/null || true)"
  if [ -z "$real" ] || inside_harness "$real"; then do_rm "$t" && note removed "$label"; fi
}

own_skills() { find "$HARNESS/skills" -mindepth 2 -maxdepth 3 -name SKILL.md 2>/dev/null | sed 's#/SKILL.md$##' | sort; }
# own_plugins: every directory under plugins/ with .claude-plugin/plugin.json; each goes to ~/.claude/skills/<name>.
own_plugins() { find "$HARNESS/plugins" -mindepth 3 -maxdepth 3 -path '*/.claude-plugin/plugin.json' 2>/dev/null | sed 's#/.claude-plugin/plugin.json$##' | sort; }
# The confined environment leaves out what only makes sense on the administrator's own machine (openspec: harness-sync):
# a skill whose frontmatter metadata says uskn-environment: admin, and the notify plugin (plugins have no frontmatter).
ADMIN_ONLY_PLUGINS="uskn-notify"
skill_environment() { # <SKILL.md>: the uskn-environment value under metadata in its frontmatter, or nothing
  [ -f "$1" ] || return 0
  awk 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit }
       /^[^[:space:]]/ { meta = ($0 ~ /^metadata:[[:space:]]*$/); next }
       meta && /^[[:space:]]+uskn-environment:/ { sub(/^[[:space:]]+uskn-environment:[[:space:]]*/, ""); gsub(/["\047[:space:]]/, ""); print; exit }' "$1"
}
left_out_skill() { confined && [ "$(skill_environment "$1/SKILL.md")" = admin ]; } # <skill dir>
left_out_plugin() { confined && case " $ADMIN_ONLY_PLUGINS " in *" $(basename "$1") "*) return 0 ;; *) return 1 ;; esac; } # <plugin dir>
check_duplicates() { # both checks read the names in this shell: an exit inside a pipeline would only end a subshell
  local names dup reserved r
  names="$(own_skills | while read -r d; do basename "$d"; done)"
  dup="$(printf '%s\n' "$names" | sort | uniq -d)"
  [ -z "$dup" ] || { echo "duplicate skill names under skills/: $dup" >&2; exit 2; }
  # A plugin's link takes ~/.claude/skills/<name>, so no skill may have that name: uskn-harness, and every plugins/ dir.
  reserved="uskn-harness $(find "$HARNESS/plugins" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | while read -r d; do basename "$d"; done | tr '\n' ' ')"
  for r in $reserved; do
    if printf '%s\n' "$names" | grep -qx "$r"; then echo "skill name $r is reserved for the plugin $r" >&2; exit 2; fi
  done
}

# --------------------------------------------------------------- managed copies
is_managed_file() { [ -f "$1" ] && head -n 1 "$1" | grep -q "$MARKER"; }
ensure_managed_file() { # src dest label
  local s="$1" d="$2" label="$3"
  if [ ! -e "$d" ] && [ ! -L "$d" ]; then do_copy "$s" "$d" && note created "$label"
  elif [ -L "$d" ]; then note conflict "$label: $d is a symlink (left untouched)"
  elif is_managed_file "$d"; then
    if cmp -s "$s" "$d"; then note ok "$label"; else do_copy "$s" "$d" && note updated "$label"; fi
  else note conflict "$label: $d exists without the '$MARKER' marker (left untouched)"; fi
}
ensure_managed_dir() { # src-dir dest-dir label
  local s="$1" d="$2" label="$3"
  if [ ! -e "$d" ] && [ ! -L "$d" ]; then
    if [ "$DRY" = 1 ]; then say plan "copy $s -> $d"; else mkdir -p "$(dirname "$d")" && cp -R "$s" "$d" && : >"$d/$MARKER_FILE" && note created "$label"; fi
  elif [ -L "$d" ]; then note conflict "$label: $d is a symlink (left untouched)"
  elif [ -f "$d/$MARKER_FILE" ]; then
    if diff -rq -x "$MARKER_FILE" "$s" "$d" >/dev/null 2>&1; then note ok "$label"
    elif [ "$DRY" = 1 ]; then say plan "refresh $d"
    else rm -rf "$d" && cp -R "$s" "$d" && : >"$d/$MARKER_FILE" && note updated "$label"; fi
  else note conflict "$label: $d exists without $MARKER_FILE (left untouched)"; fi
}

# ------------------------------------------------------------ user settings
# ~/.claude/settings.json is merged, never replaced (openspec: user-settings). The composite D is four layers merged in
# order, by the same rules as the merge into live: the common fragment templates/user/settings.json, the fragment of the
# environment kind (settings-admin.json | settings-confined.json), the fragment of the OS (settings-linux.json |
# settings-darwin.json; none on another OS), and the machine overlay. In the confined environment the overlay's keys
# that loosen the sandbox are left out first (confined_overlay) and reported. The record R is the composite the last
# sync applied (the seed -- the dotfiles' last settings.json -- when there is none). New live = live minus what R has
# and D lacks, merged with D, minus the effort /effort wrote under modelSettings. Nothing flows back from the live file.
SETTINGS_FILE="$CLAUDE_DIR/settings.json"
SETTINGS_OVERLAY="$HOME/.config/uskn-harness/settings.json"
SETTINGS_RECORD="$STATE_DIR/settings-applied.json"
# shellcheck disable=SC2016  # a jq program: its $names are jq variables
SETTINGS_JQ='
def is_set($p): (($p | length) == 2 and $p[0] == "permissions" and ($p[1] | IN("allow", "deny", "ask", "additionalDirectories")))
  or $p == ["sandbox", "excludedCommands"] or $p == ["sandbox", "filesystem", "allowWrite"]
  or $p == ["sandbox", "network", "allowedDomains"];
def has_elem($e): any(.[]; . == $e);
def merge($a; $b; $p):
  if ($a | type) == "object" and ($b | type) == "object" then
    reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k]; $p + [$k]))
  elif is_set($p) and ($b | type) == "array" then
    reduce $b[] as $e ((if ($a | type) == "array" then $a else [] end); if has_elem($e) then . else . + [$e] end)
  else $b end;
def prune($l; $r; $d; $p):
  if ($r | type) == "object" and ($l | type) == "object" then
    reduce ($r | keys_unsorted[]) as $k ($l;
      if (has($k) | not) then .
      else
        ((($d | type) == "object") and ($d | has($k))) as $in_d
        | (if $in_d then $d[$k] else null end) as $dk
        | if ((($r[$k] | type) == "object") and ((.[$k] | type) == "object"))
             or (is_set($p + [$k]) and (($r[$k] | type) == "array") and ((.[$k] | type) == "array")) then
            (.[$k] | length) as $before
            | .[$k] = prune(.[$k]; $r[$k]; $dk; $p + [$k])
            | if $before > 0 and (.[$k] | length) == 0 and ($in_d | not) then del(.[$k]) else . end
          elif $in_d then .
          else del(.[$k]) end
      end)
  elif is_set($p) and ($r | type) == "array" and ($l | type) == "array" then
    [ $l[] | . as $e | select(((($r | has_elem($e)) and ((($d | type) != "array") or ($d | has_elem($e) | not)))) | not) ]
  else $l end;
def strip_effort:
  if (.modelSettings | type) == "object" then
    .modelSettings |= with_entries(if (.value | type) == "object" then .value |= del(.effortLevel) else . end
                                   | select((.value | type) != "object" or (.value | length) > 0))
    | if (.modelSettings | length) == 0 then del(.modelSettings) else . end
  else . end;
def flat($p):
  if type == "object" then to_entries[] | .key as $k | .value | flat($p + [$k])
  elif is_set($p) and type == "array" then .[] | {key: (($p | join(".")) + "[" + tostring + "]"), value: true}
  else {key: ($p | map(tostring) | join(".")), value: .} end;
def flatmap: [flat([])] | from_entries;
def changes($old; $new):
  ($old | flatmap) as $o | ($new | flatmap) as $n
  | [$n | keys_unsorted[] | select(. as $k | $o | has($k) | not) | "add " + .]
    + [$n | to_entries[] | select(.key as $k | ($o | has($k)) and $o[$k] != .value) | "change " + .key]
    + [$o | keys_unsorted[] | select(. as $k | $n | has($k) | not) | "remove " + .];
def at($p): try getpath($p) catch null;
def wide_webfetch: type == "string" and (. == "WebFetch" or (startswith("WebFetch(domain:") and contains("*")));
# confined_overlay: the machine overlay without what would loosen the sandbox of the confined environment
# (openspec: user-settings) -> {settings, removed: [path, ...]}
def confined_overlay:
  . as $o
  | ([ (["sandbox", "excludedCommands"], ["sandbox", "allowUnsandboxedCommands"], ["sandbox", "network", "allowedDomains"],
        ["sandbox", "network", "allowAllUnixSockets"], ["sandbox", "filesystem", "allowWrite"], ["permissions", "defaultMode"])
       | select(. as $p | $o | at($p) != null) ]
     + [ (["sandbox", "failIfUnavailable"], ["sandbox", "enabled"]) | select(. as $p | $o | at($p) == false) ]) as $ps
  | ([ $o | at(["permissions", "allow"]) | arrays | .[] | select(wide_webfetch) ]) as $wf
  | { settings: (reduce $ps[] as $p ($o; delpaths([$p]))
                 | if ($wf | length) > 0 then .permissions.allow |= map(select(wide_webfetch | not)) else . end),
      removed: (($ps | map(join("."))) + ($wf | map("permissions.allow[" + . + "]"))) };
'
jqx() { if have jq; then jq "$@"; else "$(mise_bin)" exec -- jq "$@"; fi; }
is_json_object() { [ -f "$1" ] && jqx -e 'type == "object"' "$1" >/dev/null 2>&1; }
# settings_fragments: the fragment files of this machine, in the order they are merged (common, kind, OS)
settings_fragments() {
  local t="$HARNESS/templates/user"
  printf '%s\n' "$t/settings.json" "$t/settings-$ENV_KIND.json"
  case "$(host_os)" in
    Linux) printf '%s\n' "$t/settings-linux.json" ;;
    Darwin) printf '%s\n' "$t/settings-darwin.json" ;;
  esac
}
# settings_compose <workdir>: writes base.json (the fragments merged, before the machine overlay), composite.json (with
# the overlay on top) and removed.txt (the overlay paths the confined environment leaves out, one per line). On failure
# the reason goes to stdout: 1 the overlay is unreadable, 2 a fragment is unreadable or jq failed, 3 the checkout has no
# fragment.
settings_compose() {
  local w="$1" f
  [ -e "$HARNESS/templates/user/settings.json" ] || { echo "no fragment in $HARNESS"; return 3; }
  echo '{}' >"$w/base.json"
  while IFS= read -r f; do
    is_json_object "$f" || { echo "fragment $f is not a JSON object"; return 2; }
    if ! jqx -n --slurpfile a "$w/base.json" --slurpfile b "$f" "$SETTINGS_JQ merge(\$a[0]; \$b[0]; [])" >"$w/base.next"; then
      echo "jq could not merge $f"; return 2
    fi
    mv "$w/base.next" "$w/base.json"
  done < <(settings_fragments)
  if [ -e "$SETTINGS_OVERLAY" ] && ! is_json_object "$SETTINGS_OVERLAY"; then echo "$SETTINGS_OVERLAY is not a JSON object"; return 1; fi
  if [ -e "$SETTINGS_OVERLAY" ]; then cp "$SETTINGS_OVERLAY" "$w/overlay.json"; else echo '{}' >"$w/overlay.json"; fi
  : >"$w/removed.txt"
  if confined; then
    if ! { jqx "$SETTINGS_JQ confined_overlay" "$w/overlay.json" >"$w/strip.json" &&
           jqx '.settings' "$w/strip.json" >"$w/overlay.json" &&
           jqx -r '.removed[]' "$w/strip.json" >"$w/removed.txt"; }; then
      echo "jq could not filter $SETTINGS_OVERLAY"; return 2
    fi
  fi
  jqx -n --slurpfile b "$w/base.json" --slurpfile o "$w/overlay.json" "$SETTINGS_JQ merge(\$b[0]; \$o[0]; [])" >"$w/composite.json" ||
    { echo "jq could not merge the settings"; return 2; }
}
removed_note() { # <removed.txt>: the one-line report of the overlay keys the confined environment leaves out, or nothing
  [ -s "$1" ] || return 1
  printf 'user settings: the confined environment does not carry these keys of %s: %s' "$SETTINGS_OVERLAY" \
    "$(awk 'NR > 1 {printf ", "} {printf "%s", $0}' "$1")"
}
# settings_plan <workdir>: settings_compose, then record.json and new.json, and the current live file (or {}) as
# old.json. Return codes as settings_compose; 1 also when the live file is unreadable (conflict).
settings_plan() {
  local w="$1" record rc
  settings_compose "$w"; rc=$?
  [ "$rc" = 0 ] || return "$rc"
  if [ -e "$SETTINGS_FILE" ] && ! is_json_object "$SETTINGS_FILE"; then echo "$SETTINGS_FILE is not a JSON object"; return 1; fi
  if [ -e "$SETTINGS_FILE" ]; then cp "$SETTINGS_FILE" "$w/old.json"; else echo '{}' >"$w/old.json"; fi
  record="$SETTINGS_RECORD"
  is_json_object "$record" || record="$HARNESS/templates/user/settings-seed.json"
  is_json_object "$record" || { echo '{}' >"$w/seed.json"; record="$w/seed.json"; }
  cp "$record" "$w/record.json"
  if ! jqx -n --slurpfile l "$w/old.json" --slurpfile r "$w/record.json" --slurpfile d "$w/composite.json" \
         "$SETTINGS_JQ prune(\$l[0]; \$r[0]; \$d[0]; []) | merge(.; \$d[0]; []) | strip_effort" >"$w/new.json"; then
    echo "jq could not merge the settings"; return 2
  fi
}
settings_changes() { # <old.json> <new.json>: one "add|change|remove <path>" line per difference
  jqx -rn --slurpfile a "$1" --slurpfile b "$2" "$SETTINGS_JQ changes(\$a[0]; \$b[0])[]"
}
same_json() { [ "$(jqx -S -c . "$1")" = "$(jqx -S -c . "$2")" ]; }
write_json_atomic() { # <dest> <src>: replace dest in one rename, keeping its mode
  local dest="$1" tmp="$1.uskn-tmp.$$"
  mkdir -p "$(dirname "$dest")" || return 1
  if [ -e "$dest" ]; then cp -p "$dest" "$tmp" || return 1; fi
  cat "$2" >"$tmp" && mv -f "$tmp" "$dest"
}
summarize_changes() { # stdin: change lines -> "N added, N changed, N removed"
  awk '{n[$1]++} END {printf "%d added, %d changed, %d removed", n["add"], n["change"], n["remove"]}'
}
ensure_user_settings() {
  local w why rc line
  w="$(mktemp -d)"
  why="$(settings_plan "$w")"; rc=$?
  case "$rc" in
    0) ;;
    1) note conflict "user settings: $why (nothing written)"; rm -rf "$w"; return 0 ;;
    3) say skipped "user settings: $why"; rm -rf "$w"; return 0 ;;
    *) note fail "user settings: $why"; rm -rf "$w"; return 0 ;;
  esac
  if why="$(removed_note "$w/removed.txt")"; then note warn "$why"; fi
  if [ "$DRY" = 1 ]; then
    if [ -e "$SETTINGS_FILE" ] && same_json "$w/old.json" "$w/new.json"; then note ok "user settings"
    elif [ ! -e "$SETTINGS_FILE" ]; then say plan "user settings: create $SETTINGS_FILE"
    else while IFS= read -r line; do say plan "user settings: $line"; done < <(settings_changes "$w/old.json" "$w/new.json"); fi
    rm -rf "$w"; return 0
  fi
  if [ ! -e "$SETTINGS_FILE" ]; then
    if write_json_atomic "$SETTINGS_FILE" "$w/new.json"; then note created "user settings: $SETTINGS_FILE"
    else note fail "user settings: could not write $SETTINGS_FILE"; rm -rf "$w"; return 0; fi
  elif same_json "$w/old.json" "$w/new.json"; then note ok "user settings"
  elif write_json_atomic "$SETTINGS_FILE" "$w/new.json"; then
    note updated "user settings: $SETTINGS_FILE ($(settings_changes "$w/old.json" "$w/new.json" | summarize_changes))"
  else note fail "user settings: could not write $SETTINGS_FILE"; rm -rf "$w"; return 0; fi
  { [ -f "$SETTINGS_RECORD" ] && same_json "$w/composite.json" "$SETTINGS_RECORD"; } || write_json_atomic "$SETTINGS_RECORD" "$w/composite.json"
  rm -rf "$w"
}
remove_user_settings() { # sync --remove: take out what the record says the harness put in, then drop the record
  local w
  is_json_object "$SETTINGS_RECORD" || return 0
  if ! is_json_object "$SETTINGS_FILE"; then do_rm "$SETTINGS_RECORD" && note removed "user settings record"; return 0; fi
  w="$(mktemp -d)"
  echo '{}' >"$w/empty.json"
  if jqx -n --slurpfile l "$SETTINGS_FILE" --slurpfile r "$SETTINGS_RECORD" --slurpfile d "$w/empty.json" \
       "$SETTINGS_JQ prune(\$l[0]; \$r[0]; \$d[0]; [])" >"$w/new.json"; then
    if [ "$DRY" = 1 ]; then say plan "user settings: remove what $SETTINGS_RECORD lists"
    else write_json_atomic "$SETTINGS_FILE" "$w/new.json" && note removed "user settings the harness put in"; fi
  fi
  do_rm "$SETTINGS_RECORD"
  rm -rf "$w"
}
cmd_print_settings() { # the composite sync would apply, on stdout; never writes (openspec: user-settings)
  local w why rc
  w="$(mktemp -d)" || return 1
  why="$(settings_compose "$w")"; rc=$?
  if [ "$rc" != 0 ]; then echo "print-settings: $why" >&2; rm -rf "$w"; return 1; fi
  if why="$(removed_note "$w/removed.txt")"; then echo "warn: $why" >&2; fi
  jqx . "$w/composite.json"; rc=$?
  rm -rf "$w"
  return "$rc"
}
check_user_settings() { # doctor: live against what sync would write; read-only
  local w why rc diff
  [ -e "$SETTINGS_FILE" ] || { note warn "user settings: $SETTINGS_FILE missing (run uskn-harness sync)"; return 0; }
  w="$(mktemp -d)"
  why="$(settings_plan "$w")"; rc=$?
  if [ "$rc" = 0 ] && why="$(removed_note "$w/removed.txt")"; then note warn "$why (sync leaves them out)"; fi
  if [ "$rc" != 0 ]; then note warn "user settings: $why"
  elif same_json "$w/old.json" "$w/new.json"; then note ok "user settings"
  else
    diff="$(settings_changes "$w/old.json" "$w/new.json" | head -n 5 | awk 'NR > 1 {printf "; "} {printf "%s", $0}')"
    note warn "user settings: sync would $diff (run uskn-harness sync)"
  fi
  rm -rf "$w"
}
check_sandbox_deps() { # doctor: the Linux sandbox runs on bwrap and socat; without them Bash runs unconfined (ADR-0009)
  local missing="" t
  [ "$(host_os)" = Linux ] || return 0
  [ -e "$SETTINGS_FILE" ] && jqx -e '.sandbox.enabled == true' "$SETTINGS_FILE" >/dev/null 2>&1 || return 0
  for t in bwrap socat; do have "$t" || missing="${missing:+$missing, }$t"; done
  if [ -n "$missing" ]; then
    note warn "sandbox: $missing missing, so Bash runs without limits (install the packages bubblewrap and socat)"
    return 0
  fi
  # Running inside the sandbox already proves bwrap could nest a user namespace on this machine; probing from in
  # here would fail on the sandbox's own limits, not on the machine (openspec: harness-doctor)
  if [ -n "${SANDBOX_RUNTIME:-}" ]; then
    note ok "sandbox: bwrap and socat (inside the sandbox, so the nested user namespace is not probed)"
    return 0
  fi
  # The sandbox creates a second user namespace inside bwrap and writes its uid map; Ubuntu 26.04's
  # bwrap-userns-restrict profile denies exactly that while plain bwrap still works (issue #17)
  if bwrap --ro-bind / / --dev /dev --proc /proc --unshare-user -- unshare --user --map-root-user true \
    </dev/null >/dev/null 2>&1; then
    note ok "sandbox: bwrap and socat, and bwrap can create a nested user namespace"
  else
    note warn "sandbox: bwrap cannot create a nested user namespace, so every Bash command in the sandbox fails (see the sandbox section of docs/setup-new-machine.md)"
  fi
}

# ------------------------------------------------------------ notify plugin
# The uskn-notify commands also go into ~/.local/bin (openspec: notify-plugin): claude-notify-ntfy-sub and the
# LaunchAgent plists name that path, the user runs the opt-in installs from a shell, and on WSL claude-notify finds
# claude-notify.ps1 next to itself. A LaunchAgent the user installed is installed again when its command changes,
# through ~/.local/bin so the plist never names the checkout; sync never installs one on its own.
NOTIFY_BIN_DIR="$HOME/.local/bin"
NOTIFY_AGENTS="com.claude.notify-daemon:claude-notify-daemon com.claude.notify-ntfy-sub:claude-notify-ntfy-sub"
notify_commands() { find "$HARNESS/plugins/uskn-notify/bin" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | sort; }
ensure_notify_commands() {
  local c
  for c in $(notify_commands); do ensure_link "$NOTIFY_BIN_DIR/$(basename "$c")" "$c" "notify command $(basename "$c")"; done
}
remove_notify_commands() {
  local c
  for c in $(notify_commands); do remove_link "$NOTIFY_BIN_DIR/$(basename "$c")" "notify command $(basename "$c")"; done
}
check_notify_commands() { # doctor
  local c
  for c in $(notify_commands); do check_link "$NOTIFY_BIN_DIR/$(basename "$c")" "$c" "notify command $(basename "$c")"; done
}
host_os() { printf '%s' "${USKN_HARNESS_OS:-$(uname -s)}"; }
file_sha256() { if have sha256sum; then sha256sum "$1"; else shasum -a 256 "$1"; fi | awk '{print $1}'; }
ensure_notify_agents() {
  [ "$(host_os)" = Darwin ] || return 0
  confined && return 0
  local pair label cmd src rec want
  for pair in $NOTIFY_AGENTS; do
    label="${pair%%:*}"; cmd="${pair#*:}"
    src="$HARNESS/plugins/uskn-notify/bin/$cmd"
    if [ ! -f "$HOME/Library/LaunchAgents/$label.plist" ] || [ ! -f "$src" ]; then continue; fi
    rec="$STATE_DIR/notify-installed/$label.sha256"
    want="$(file_sha256 "$src")"
    if [ -f "$rec" ] && [ "$(cat "$rec")" = "$want" ]; then note ok "LaunchAgent $label"; continue; fi
    if run_step "LaunchAgent $label" "$NOTIFY_BIN_DIR/$cmd" install; then
      mkdir -p "$(dirname "$rec")" && printf '%s\n' "$want" >"$rec" && note updated "LaunchAgent $label (installed again: $cmd changed)"
    fi
  done
}

# ------------------------------------------------------------------ runtime
mise_bin() { if have mise; then command -v mise; else echo "$HOME/.local/bin/mise"; fi; }
# mise_global_node <major>: the node version mise's global config sets, when its major is <major>. Asked in /, where no
# project mise.toml applies; a node that is not mise's (Homebrew's) does not count, though `mise exec` would run it.
mise_global_node() {
  local v
  v="$("$(mise_bin)" -C / current node 2>/dev/null | awk '{print $1}')"
  case "$v" in "$1" | "$1".*) printf '%s' "$v" ;; *) return 1 ;; esac
}
ensure_runtime() {
  local node_ver mise cur
  node_ver="$(deps_get '.runtimes.node.version' 24)"
  if [ -x "$(mise_bin)" ]; then note ok "mise ($(mise_bin))"
  else run_step "install mise" bash -c "curl -fsSL https://mise.run | MISE_INSTALL_PATH='$HOME/.local/bin/mise' sh" && note created "mise -> ~/.local/bin/mise"; fi
  mise="$(mise_bin)"
  if stub || [ "$DRY" = 1 ]; then run_step "mise global node" "$mise" use -g "node@$node_ver"
  elif cur="$(mise_global_node "$node_ver")"; then note ok "node $cur (mise global)"
  else run_step "mise global node" "$mise" use -g "node@$node_ver" && note created "node $node_ver (mise global)"; fi
  if have jq; then note ok "jq ($(command -v jq))"
  else run_step "mise global jq" "$mise" use -g "jq@$(deps_get '.runtimes.jq.version' 1.7)" && note created "jq (mise global)"; fi
}

# ---------------------------------------------------------- pinned npm globals
# npm_root: where `npm install -g` puts packages. USKN_NPM_ROOT overrides it (tests); fails under the stub.
npm_root() {
  local r
  if [ -n "${USKN_NPM_ROOT:-}" ]; then printf '%s' "$USKN_NPM_ROOT"; return 0; fi
  stub && return 1
  r="$("$(mise_bin)" -C / exec -- npm root -g 2>/dev/null | tail -n 1)"
  [ -n "$r" ] || return 1
  printf '%s' "$r"
}
pkg_version() { # <npm root> <package>: the installed version, or failure
  local f="$1/$2/package.json"
  [ -f "$f" ] || return 1
  if have jq; then jq -r '.version // empty' "$f"; else sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | head -n 1; fi
}
# npm_pins: one line per cli with global:true -- key, install specs (pkg@ver ...), checks (pkg=ver ...)
npm_pins() {
  jq -r '.clis | to_entries[] | select(.value.global == true) |
    [ .key,
      ([ "\(.value.package)@\(.value.version)" ] + ((.value.bundle // {}) | to_entries | map("\(.key)@\(.value)")) | join(" ")),
      ([ "\(.value.package)=\(.value.version)" ] + ((.value.bundle // {}) | to_entries | map("\(.key)=\(.value)")) | join(" "))
    ] | @tsv' "$HARNESS/deps.json"
}
ensure_npm_globals() {
  have jq || { note warn "jq missing: pinned npm CLIs skipped"; return 0; }
  local key specs checks root c name want cur stale v installed=0
  root="$(npm_root || true)"
  while IFS=$'\t' read -r -u 3 key specs checks; do
    [ -n "$key" ] || continue
    stale=""
    if [ -z "$root" ]; then stale="not checked"
    else
      for c in $checks; do
        name="${c%=*}"; want="${c##*=}"
        cur="$(pkg_version "$root" "$name" 2>/dev/null || true)"
        [ "$cur" = "$want" ] || { stale="$name ${cur:-none} -> $want"; break; }
      done
    fi
    if [ -z "$stale" ]; then v="${checks%% *}"; note ok "$key ${v##*=}"
    else
      # shellcheck disable=SC2086
      # Installed from /, as npm_root asks: a project mise.toml in the caller's directory would pick another node.
      run_step "npm global $key" "$(mise_bin)" -C / exec -- npm install -g $specs && { note created "$key ($specs)"; installed=1; }
    fi
  done 3< <(npm_pins)
  [ "$installed" = 1 ] && run_step "mise reshim" "$(mise_bin)" reshim >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------- the confined environment's tools
# In the confined environment sync installs nothing: the administrator put the tools into the shared tools dir named by
# the marker's tools= line (install-shared), and sync and doctor compare its installed.json with deps.json.
shared_tools_dir_ok() { # report a fail when the marker names no shared tools dir, or it does not exist
  if [ -z "$ENV_TOOLS" ]; then note fail "$1: the environment marker $HARNESS/.uskn-environment has no tools= line (the administrator sets it)"; return 1; fi
  if [ ! -d "$ENV_TOOLS" ]; then note fail "$1: $ENV_TOOLS does not exist (the administrator runs uskn-harness install-shared $ENV_TOOLS)"; return 1; fi
}
check_shared_tools() { # sync step 2 and doctor: node, jq and every pinned CLI against the shared tools record
  have jq || { note fail "shared tools: jq missing"; return 0; }
  shared_tools_dir_ok "shared tools" || return 0
  local kind key want have wv hv
  while read -r kind key; do
    want="$(shared_want "$kind" "$key")"; have="$(shared_have "$ENV_TOOLS" "$kind" "$key")"
    wv="$(jq -r .version <<<"$want")"
    if same_pin "$have" "$want"; then note ok "$key $wv (shared tools $ENV_TOOLS)"; continue; fi
    hv="$( [ -n "$have" ] && jq -r '.version // "no version"' <<<"$have" || echo "not recorded")"
    note warn "$key: the shared tools record has $hv, deps.json pins $wv (the administrator runs uskn-harness install-shared $ENV_TOOLS)"
  done < <(printf 'runtimes node\nruntimes jq\n'; jq -r '.clis | to_entries[] | select(.value.global == true) | "clis " + .key' "$HARNESS/deps.json")
}
shared_skill_names() { jq -r '.skills | to_entries[] | select(.value.mode == "reference" and .value.via != null) | .key' "$HARNESS/deps.json"; }
ensure_shared_skills() { # sync step 6: ~/.claude/skills/<name> -> <tools>/skills/<name>; never the skills CLI
  have jq || { note warn "jq missing: third-party skills skipped"; return 0; }
  shared_tools_dir_ok "third-party skills" || return 0
  local name
  while IFS= read -r -u 3 name; do
    [ -n "$name" ] || continue
    if [ ! -d "$ENV_TOOLS/skills/$name" ]; then
      note warn "third-party $name: $ENV_TOOLS/skills/$name missing (the administrator runs uskn-harness install-shared $ENV_TOOLS)"; continue
    fi
    ensure_link "$SKILLS_DIR/$name" "$ENV_TOOLS/skills/$name" "third-party $name"
  done 3< <(shared_skill_names)
}

# ---------------------------------------------------------- third-party skills
# deps.json `skills` entries with `via` (openspec: harness-sync). `via: skills` goes through the skills CLI pinned in
# clis.skills as <source>#<ref>@<name>. The CLI records the ref in its lock file; a ref that differs from deps.json
# means reinstall, and a skill directory the lock does not know was placed by someone else and stays untouched.
skill_lock() { # the skills CLI lock file, found the way the CLI finds it
  if [ -n "${XDG_STATE_HOME:-}" ]; then printf '%s' "$XDG_STATE_HOME/skills/.skill-lock.json"
  else printf '%s' "$HOME/.agents/.skill-lock.json"; fi
}
lock_ref() { # <name>: the ref the lock records for <name>, empty when it has none; fails when <name> is not in the lock
  local f; f="$(skill_lock)"
  [ -f "$f" ] || return 1
  jq -er --arg n "$1" '.skills[$n] // empty | .ref // ""' "$f" 2>/dev/null
}
short_ref() { if [ -n "$1" ]; then printf '%.12s' "$1"; else printf 'no ref'; fi; }
skills_cli_entries() { # name, source, ref of every entry sync installs through the skills CLI
  jq -r '.skills | to_entries[] | select(.value.mode == "reference" and .value.via == "skills") | [.key, .value.source, .value.ref] | @tsv' "$HARNESS/deps.json"
}
ensure_skills_cli_skill() { # name source ref cli-version
  local name="$1" ref="$3" label="third-party $1" have
  local -a cmd=("$(mise_bin)" exec -- npx -y "skills@$4" add "$2#$3@$1" -g -a claude-code -y)
  if [ ! -e "$SKILLS_DIR/$name" ] && [ ! -L "$SKILLS_DIR/$name" ]; then
    run_step "$label" "${cmd[@]}" && note created "$label $(short_ref "$ref")"
  elif ! have="$(lock_ref "$name")"; then
    note conflict "$label: $SKILLS_DIR/$name is not in the skills CLI lock $(skill_lock) (left untouched)"
  elif [ "$have" = "$ref" ]; then note ok "$label $(short_ref "$ref")"
  else run_step "$label" "${cmd[@]}" && note updated "$label $(short_ref "$have") -> $(short_ref "$ref")"; fi
}
# `via: impeccable`: the Impeccable CLI alone always fetches the latest skill, so sync downloads the release asset of
# `ref`, checks it against `sha256` (the CLI skips its signature check for a local bundle), and hands it to the CLI
# pinned in `cli` through IMPECCABLE_BUNDLE_PATH. The installed version is the `version` in the skill's SKILL.md.
# Every install writes the agents listed in `remove_agents`; they are removed after the step.
skill_version() { # <SKILL.md>: the version in its frontmatter, or nothing
  [ -f "$1" ] || return 0
  awk 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit }
       /^version:/ { sub(/^version:[[:space:]]*/, ""); gsub(/["\047[:space:]]/, ""); print; exit }' "$1"
}
sha256_of() { # <file>
  local out
  if have sha256sum; then out="$(sha256sum "$1")" || return 1
  elif have shasum; then out="$(shasum -a 256 "$1")" || return 1
  else echo "neither sha256sum nor shasum found" >&2; return 1; fi
  printf '%s' "${out%% *}"
}
impeccable_install() { # <asset url> <sha256> <cli package@version>: download, check, install through the CLI
  local url="$1" want="$2" cli="$3" tmp zip got rc=0
  tmp="$(mktemp -d)" || return 1
  zip="$tmp/${url##*/}"
  if ! curl -fsSL -o "$zip" "$url"; then echo "download failed: $url" >&2; rc=1
  elif ! got="$(sha256_of "$zip")"; then rc=1
  elif [ "$got" != "$want" ]; then echo "sha256 mismatch for $url: got $got, want $want (the CLI was not run)" >&2; rc=1
  else IMPECCABLE_BUNDLE_PATH="$zip" "$(mise_bin)" exec -- npx -y "$cli" install -y --providers=claude --scope=global --no-hooks || rc=$?
  fi
  rm -rf "$tmp"
  return "$rc"
}
listed_agents() { # <name>: the agent files deps.json lists under remove_agents for <name> that exist, one per line
  local a f
  while IFS= read -r a; do
    case "$a" in "" | */* | .*) continue ;; esac
    f="$CLAUDE_DIR/agents/$a.md"
    if [ -e "$f" ] || [ -L "$f" ]; then printf '%s\n' "$f"; fi
  done < <(jq -r --arg n "$1" '.skills[$n].remove_agents // [] | .[]' "$HARNESS/deps.json")
}
remove_agents() { # <name>: delete those files, and only those
  local f
  while IFS= read -r f; do do_rm "$f" && note removed "$1 agent $f"; done < <(listed_agents "$1")
}
impeccable_entries() { jq -r '.skills | to_entries[] | select(.value.mode == "reference" and .value.via == "impeccable") | .key' "$HARNESS/deps.json"; }
ensure_impeccable() { # <name>: the deps.json key of a via:impeccable entry
  local name="$1" label="third-party $1" e want src ref asset sha pkg cliv cur url
  e=".skills[\"$name\"]"
  want="$(deps_get "$e.version" '')"; src="$(deps_get "$e.source" '')"; ref="$(deps_get "$e.ref" '')"
  asset="$(deps_get "$e.asset" '')"; sha="$(deps_get "$e.sha256" '')"
  pkg="$(deps_get "$e.cli.package" '')"; cliv="$(deps_get "$e.cli.version" '')"
  if [ -z "$want" ] || [ -z "$src" ] || [ -z "$ref" ] || [ -z "$asset" ] || [ -z "$sha" ] || [ -z "$pkg" ] || [ -z "$cliv" ]; then
    note fail "$label: deps.json lacks one of version, source, ref, asset, sha256, cli.package, cli.version"; return 0
  fi
  url="https://github.com/$src/releases/download/$ref/$asset"
  cur="$(skill_version "$SKILLS_DIR/$name/SKILL.md")"
  if [ ! -e "$SKILLS_DIR/$name" ] && [ ! -L "$SKILLS_DIR/$name" ]; then
    run_step "$label" impeccable_install "$url" "$sha" "$pkg@$cliv" && note created "$label $want"
  elif [ -z "$cur" ]; then note conflict "$label: $SKILLS_DIR/$name/SKILL.md has no version (left untouched)"; return 0
  elif [ "$cur" = "$want" ]; then note ok "$label $want"
  else run_step "$label" impeccable_install "$url" "$sha" "$pkg@$cliv" && note updated "$label $cur -> $want"; fi
  remove_agents "$name"
}
ensure_third_party() {
  have jq || { note warn "jq missing: third-party skills skipped"; return 0; }
  local name source ref ver
  ver="$(deps_get '.clis.skills.version' '')"
  while IFS=$'\t' read -r -u 3 name source ref; do
    [ -n "$name" ] || continue
    if [ -z "$ver" ] || [ -z "$source" ] || [ -z "$ref" ]; then note fail "third-party $name: deps.json pins no skills CLI version, source, or ref"; continue; fi
    ensure_skills_cli_skill "$name" "$source" "$ref" "$ver"
  done 3< <(skills_cli_entries)
  while IFS= read -r -u 3 name; do
    [ -n "$name" ] && ensure_impeccable "$name"
  done 3< <(impeccable_entries)
}

# ------------------------------------------------------------ shared tools
# install-shared <dir> (openspec: shared-tools; design D5): the administrator puts the pinned tools and third-party
# skills where a confined user can read but not write them. <dir>/mise is node's and jq's MISE_DATA_DIR, <dir>/npm the
# npm prefix of the pinned CLIs, <dir>/bin links to node, npm, npx, jq and every CLI's bin, <dir>/skills/<name> each
# skill with `via`, <dir>/installed.json what was installed. It never touches the user layer, nor <dir>'s owner or
# mode: the terminal base decides those.
SHARED=""
shared_want() { # <kind> <key>: the pin of an item as installed.json records it (compact JSON)
  case "$1" in
    runtimes) jq -c --arg k "$2" '{version: .runtimes[$k].version}' "$HARNESS/deps.json" ;;
    clis) jq -c --arg k "$2" '.clis[$k] | {version, bundle: (.bundle // {})}' "$HARNESS/deps.json" ;;
    skills) jq -c --arg k "$2" '.skills[$k] | {ref, version}' "$HARNESS/deps.json" ;;
  esac
}
shared_have() { # <dir> <kind> <key>: what <dir>/installed.json records for an item, or nothing
  [ -f "$1/installed.json" ] && jq -c --arg c "$2" --arg k "$3" '.[$c][$k] // empty' "$1/installed.json" 2>/dev/null
}
same_pin() { [ -n "$1" ] && [ "$(jq -cS . <<<"$1")" = "$(jq -cS . <<<"$2")" ]; }
shared_record() { # <kind> <key> <json>: write the item into installed.json
  local f="$SHARED/installed.json" w
  w="$(mktemp -d)" || return 1
  if is_json_object "$f"; then cp "$f" "$w/old.json"; else echo '{}' >"$w/old.json"; fi
  jq --arg c "$1" --arg k "$2" --argjson v "$3" '.[$c][$k] = $v' "$w/old.json" >"$w/new.json" && write_json_atomic "$f" "$w/new.json"
  rm -rf "$w"
}
shared_link() { # <target> <link>
  if [ "$DRY" = 1 ]; then say plan "link $2 -> $1"; return 0; fi
  mkdir -p "$(dirname "$2")" && ln -sfn "$1" "$2"
}
shared_copy_skill() { # <source dir> <dest>: replace <dest> with a copy of the source, links resolved
  local dest="$2"
  [ -d "$1" ] || { echo "no skill directory $1" >&2; return 1; }
  rm -rf "$dest.new" && cp -RL "$1" "$dest.new" && rm -rf "$dest" && mv "$dest.new" "$dest"
}
in_dir() { local d="$1"; shift; (cd "$d" && "$@"); }
shared_impeccable() { # <asset url> <sha256> <cli package@version> <name> <dest>: as impeccable_install, into <dest>
  local url="$1" want="$2" cli="$3" tmp zip got rc=0
  tmp="$(mktemp -d)" || return 1
  zip="$tmp/${url##*/}"
  if ! curl -fsSL -o "$zip" "$url"; then echo "download failed: $url" >&2; rc=1
  elif ! got="$(sha256_of "$zip")"; then rc=1
  elif [ "$got" != "$want" ]; then echo "sha256 mismatch for $url: got $got, want $want (the CLI was not run)" >&2; rc=1
  else
    # A throwaway HOME takes the global install, so the CLI writes neither the user layer nor the agents it adds.
    mkdir -p "$tmp/home"
    env -u CLAUDE_CONFIG_DIR HOME="$tmp/home" PATH="$SHARED/bin:$PATH" IMPECCABLE_BUNDLE_PATH="$zip" \
      "$SHARED/bin/npx" -y "$cli" install -y --providers=claude --scope=global --no-hooks || rc=$?
    [ "$rc" = 0 ] && { shared_copy_skill "$tmp/home/.claude/skills/$4" "$5" || rc=1; }
  fi
  rm -rf "$tmp"
  return "$rc"
}
shared_item() { # <kind> <key> <label> <command...>: 0 after running the command; 1 when installed.json already
  # records the pin (reported ok), or the command did not run or failed. shared_installed records it afterwards.
  local kind="$1" key="$2" label="$3"
  shift 3
  if same_pin "$(shared_have "$SHARED" "$kind" "$key")" "$(shared_want "$kind" "$key")"; then note ok "$label"; return 1; fi
  run_step "$label" "$@"
}
shared_installed() { # <kind> <key> <label>: record the pin and report created or updated
  local had
  had="$(shared_have "$SHARED" "$1" "$2")"
  shared_record "$1" "$2" "$(shared_want "$1" "$2")" || { note fail "$3: could not write $SHARED/installed.json"; return 0; }
  if [ -n "$had" ]; then note updated "$3"; else note created "$3"; fi
}
shared_runtime() { # <key> <mise tool>: install it under <dir>/mise, then link its executables into <dir>/bin
  local key="$1" v mise where b
  v="$(jq -r --arg k "$key" '.runtimes[$k].version' "$HARNESS/deps.json")"; mise="$(mise_bin)"
  shared_item runtimes "$key" "shared $key $v" env MISE_DATA_DIR="$SHARED/mise" "$mise" install "$2@$v" || return 0
  where="$(env MISE_DATA_DIR="$SHARED/mise" "$mise" where "$2@$v" 2>/dev/null)"
  [ -n "$where" ] || { note fail "shared $key: mise where $2@$v gave no directory"; return 0; }
  if [ "$key" = node ]; then for b in node npm npx; do shared_link "$where/bin/$b" "$SHARED/bin/$b"; done
  elif [ -e "$where/bin/$key" ]; then shared_link "$where/bin/$key" "$SHARED/bin/$key"
  else shared_link "$where/$key" "$SHARED/bin/$key"; fi
  shared_installed runtimes "$key" "shared $key $v"
}
cmd_install_shared() { # [--dry-run] <dir>
  local key specs checks b name source ref ver e label tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      -*) echo "install-shared: unknown option: $1" >&2; return 2 ;;
      *) [ -z "$SHARED" ] || { echo "install-shared: unexpected argument: $1" >&2; return 2; }; SHARED="$1" ;;
    esac
    shift
  done
  [ -n "$SHARED" ] || { echo "install-shared: give the shared tools directory, such as /opt/uskn-tools" >&2; return 2; }
  have jq || { echo "install-shared: jq is required (run uskn-harness sync first)" >&2; return 1; }
  case "$SHARED" in /*) ;; *) SHARED="$(pwd -P)/$SHARED" ;; esac
  say info "shared tools: $SHARED"
  if [ "$DRY" = 0 ]; then mkdir -p "$SHARED/bin" "$SHARED/npm" "$SHARED/skills" || { echo "install-shared: cannot create $SHARED" >&2; return 1; }; fi
  shared_runtime node node
  shared_runtime jq jq
  while IFS=$'\t' read -r -u 3 key specs checks; do
    [ -n "$key" ] || continue
    label="shared $key ${checks%% *}"
    # shellcheck disable=SC2086  # specs is one word per package
    shared_item clis "$key" "$label" env PATH="$SHARED/bin:$PATH" "$SHARED/bin/npm" install -g --prefix "$SHARED/npm" $specs || continue
    b="$(jq -r --arg k "$key" '.clis[$k].bin // empty' "$HARNESS/deps.json")"
    [ -z "$b" ] || shared_link "$SHARED/npm/bin/$b" "$SHARED/bin/$b"
    shared_installed clis "$key" "$label"
  done 3< <(npm_pins)
  ver="$(deps_get '.clis.skills.version' '')"
  while IFS=$'\t' read -r -u 3 name source ref; do
    [ -n "$name" ] || continue
    label="shared skill $name $(short_ref "$ref")"
    # The skills CLI at project scope, in a temporary project; its .claude/skills/<name> is copied into <dir>.
    tmp="$(mktemp -d)" || { note fail "$label: mktemp failed"; continue; }
    if shared_item skills "$name" "$label" in_dir "$tmp" env PATH="$SHARED/bin:$PATH" "$SHARED/bin/npx" -y "skills@$ver" add "$source#$ref@$name" -a claude-code -y; then
      if shared_copy_skill "$tmp/.claude/skills/$name" "$SHARED/skills/$name"; then shared_installed skills "$name" "$label"
      else note fail "$label: the skills CLI wrote no .claude/skills/$name"; fi
    fi
    rm -rf "$tmp"
  done 3< <(skills_cli_entries)
  while IFS= read -r -u 3 name; do
    [ -n "$name" ] || continue
    e=".skills[\"$name\"]"; label="shared skill $name $(deps_get "$e.version" '')"
    shared_item skills "$name" "$label" shared_impeccable \
      "https://github.com/$(deps_get "$e.source" '')/releases/download/$(deps_get "$e.ref" '')/$(deps_get "$e.asset" '')" \
      "$(deps_get "$e.sha256" '')" "$(deps_get "$e.cli.package" '')@$(deps_get "$e.cli.version" '')" "$name" "$SHARED/skills/$name" &&
      shared_installed skills "$name" "$label"
  done 3< <(impeccable_entries)
  say "done" "$CHANGED change(s), $WARNS warning(s), $FAILS failure(s)"
  [ "$FAILS" -eq 0 ] && return 0
  echo "uskn-harness install-shared: $FAILS step(s) failed (the fail lines above); fix the cause and run it again" >&2
  return 1
}

# ------------------------------------------------------------------ cleanup
# prune_session_state: the hooks keep one dir per session under $STATE_DIR/sessions, and nothing reads an old one
# back. A dir goes once neither it nor anything inside changed for 30 days: files are rewritten in place, which
# leaves the dir's own mtime behind, so the newest entry decides. A dir that cannot be removed is a warning.
prune_session_state() {
  local root="$STATE_DIR/sessions" d n=0 planned=0 bad=0
  if [ -d "$root" ]; then
    while IFS= read -r -d '' d; do
      [ -z "$(find "$d" -mmin -"$STATE_MAX_MIN" -print 2>/dev/null | head -n 1)" ] || continue
      if [ "$DRY" = 1 ]; then say plan "remove $d (session state untouched for 30 days)"; planned=$((planned + 1))
      elif rm -rf "$d"; then n=$((n + 1))
      else note warn "session state: could not remove $d"; bad=1; fi
    done < <(find "$root" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
  fi
  if [ "$n" -gt 0 ]; then note removed "session state: $n session dir(s) untouched for 30 days under $root"
  elif [ "$planned" = 0 ] && [ "$bad" = 0 ]; then note ok "session state ($root)"; fi
}

# The user layer gets the OpenSpec commands (/opsx:*) only. profile and delivery exist only in the per-user global
# config, which also drives `openspec update` in every product repo, so it is never changed: openspec alone sees a
# throwaway XDG_CONFIG_HOME holding them. mise keeps the real one, or it would lose its global node.
OPSX_WORKFLOWS="apply archive explore propose sync update"
ensure_openspec_user_layer() {
  if [ "$DRY" = 1 ]; then say plan "generate openspec Claude commands into $COMMANDS_DIR/opsx"; return 0; fi
  if stub; then printf '%s\n' "openspec-user-layer${ENV_TOOLS:+ $ENV_TOOLS/bin/openspec}" >>"${USKN_HARNESS_STUB_LOG:-/dev/null}"; say stub "openspec user-layer commands"; return 0; fi
  local tmp; local -a run
  tmp="$(mktemp -d)"
  mkdir -p "$tmp/config/openspec" "$tmp/project"
  printf '%s\n' '{"profile":"core","delivery":"commands"}' >"$tmp/config/openspec/config.json"
  # The confined environment runs the shared tools' openspec, never one under the home the agent can replace.
  if confined; then run=(env PATH="$ENV_TOOLS/bin:$PATH" XDG_CONFIG_HOME="$tmp/config" "$ENV_TOOLS/bin/openspec")
  else run=("$(mise_bin)" exec -- env XDG_CONFIG_HOME="$tmp/config" openspec); fi
  if ! (cd "$tmp/project" && "${run[@]}" init --tools claude --language ja --no-animation >"$tmp/init.log" 2>&1); then
    note warn "openspec init failed in a temp dir; user-layer commands not refreshed ($(tail -n 1 "$tmp/init.log" 2>/dev/null))"; rm -rf "$tmp"; return 0
  fi
  if [ -d "$tmp/project/.claude/commands/opsx" ]; then ensure_managed_dir "$tmp/project/.claude/commands/opsx" "$COMMANDS_DIR/opsx" "openspec commands opsx"
  else note warn "openspec init wrote no .claude/commands/opsx; user-layer commands not refreshed"; fi
  rm -rf "$tmp"
}
prune_openspec_skills() { # the openspec-* skill copies an earlier sync installed (marker); anything else is not ours
  local d
  for d in "$SKILLS_DIR"/openspec-*; do
    if [ ! -d "$d" ] || [ -L "$d" ] || [ ! -f "$d/$MARKER_FILE" ]; then continue; fi
    do_rm "$d" && note removed "openspec skill $(basename "$d") (the user layer has /opsx:* commands only)"
  done
  return 0
}

# stale_skill_links: symlinks in ~/.claude/skills that point into the harness skills/ (directly or through the
# stable path, absolute or relative) at something that no longer exists -- skills deleted from the harness. The names
# of current skills are left out: ensure_link relinks those. The target is folded as text, since a dangling link
# cannot be resolved.
stale_skill_links() {
  local l name current stable
  stable="$(stable_phys)"
  current=" $(own_skills | while read -r d; do basename "$d"; done | tr '\n' ' ') "
  for l in "$SKILLS_DIR"/*; do
    if [ ! -L "$l" ] || [ -e "$l" ]; then continue; fi
    name="$(basename "$l")"
    case "$current" in *" $name "*) continue ;; esac
    case "$(link_target_text "$l")" in "$HARNESS"/skills/* | "$STABLE"/skills/* | "$stable"/skills/*) printf '%s\n' "$l" ;; esac
  done
}
prune_stale_skill_links() {
  local l
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    do_rm "$l" && note removed "stale skill link $(basename "$l") (its target left the harness)"
  done < <(stale_skill_links)
  return 0
}

# ------------------------------------------------------------------ update
# update_checkout: fast-forward the checkout before installing from it, so one `sync` is enough on another
# machine. Deliberately timid -- a clean checkout, on a branch with an upstream, `--ff-only`, no merge, no
# rebase -- because this checkout is also where the owner works. Any doubt and it says why, then installs the
# local version anyway. When HEAD moves it re-executes: bash reads a script as it runs, and the rest of the
# install should be the new sync. USKN_HARNESS_REEXEC keeps that to one hop.
update_checkout() {
  confined && { say skipped "update: confined environment (the administrator updates the checkout)"; return 0; }
  [ "$NO_PULL" = 1 ] && { say skipped "update: --no-pull"; return 0; }
  [ "${USKN_HARNESS_REEXEC:-0}" = 1 ] && return 0
  have git || { say skipped "update: git not found"; return 0; }
  git -C "$HARNESS" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { say skipped "update: not a git checkout"; return 0; }
  local branch before after; local -a cmd=()
  branch="$(git -C "$HARNESS" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [ -n "$branch" ] || { say skipped "update: detached HEAD"; return 0; }
  git -C "$HARNESS" rev-parse --verify --quiet '@{u}' >/dev/null 2>&1 || { say skipped "update: $branch has no upstream"; return 0; }
  [ -z "$(git -C "$HARNESS" status --porcelain 2>/dev/null)" ] || { say skipped "update: uncommitted changes in $HARNESS"; return 0; }
  before="$(git -C "$HARNESS" rev-parse HEAD 2>/dev/null || true)"
  # Never wait on a network or a credential prompt: installing matters more than updating.
  have timeout && cmd=(timeout 30)
  cmd+=(env GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -oBatchMode=yes" git -C "$HARNESS" pull --ff-only --quiet)
  run_step --soft "harness pull ($branch)" "${cmd[@]}" || return 0
  after="$(git -C "$HARNESS" rev-parse HEAD 2>/dev/null || true)"
  [ "$before" = "$after" ] && { note ok "harness up to date ($branch)"; return 0; }
  note updated "harness $branch $(printf '%.7s' "$before") -> $(printf '%.7s' "$after")"
  [ -x "$HARNESS/bin/uskn-harness" ] || return 0
  [ "${#ORIG_ARGV[@]}" -gt 0 ] || return 0
  export USKN_HARNESS_REEXEC=1
  exec "$HARNESS/bin/uskn-harness" "${ORIG_ARGV[@]}"
}

# ---------------------------------------------------------------- commands
finish_sync() { # the done line; 1 after a failed step, so a bootstrap that runs sync is retried next time
  say "done" "$CHANGED change(s), $WARNS warning(s), $FAILS failure(s)"
  [ "$FAILS" -eq 0 ] && return 0
  echo "uskn-harness sync: $FAILS step(s) failed (the fail lines above); fix the cause and run 'uskn-harness sync' again" >&2
  return 1
}
cmd_sync() {
  local d name
  if [ "$TOOLS" = 1 ]; then # CI runners: the tools make verify needs, nothing user-specific
    say info "harness: $HARNESS (tools only)"
    if confined; then check_shared_tools; else ensure_runtime; ensure_npm_globals; fi
    ensure_link "$SCHEMA_LINK" "$HARNESS/schemas/uskn" "openspec schema uskn"
    finish_sync; return
  fi
  check_duplicates
  if [ "$REMOVE" = 1 ]; then
    for d in $(own_skills); do remove_link "$SKILLS_DIR/$(basename "$d")" "skill $(basename "$d")"; done
    prune_stale_skill_links
    for d in $(own_plugins); do remove_link "$SKILLS_DIR/$(basename "$d")" "plugin $(basename "$d")"; done
    remove_notify_commands
    remove_link "$SCHEMA_LINK" "openspec schema uskn"
    remove_link "$BIN_LINK" "executable"
    remove_link "$LOOP_LINK" "loop runner"
    remove_link "$STABLE" "stable path"
    is_managed_file "$CLAUDE_DIR/CLAUDE.md" && do_rm "$CLAUDE_DIR/CLAUDE.md" && note removed "user CLAUDE.md"
    remove_user_settings
    for d in "$SKILLS_DIR"/openspec-* "$COMMANDS_DIR/opsx"; do [ -f "$d/$MARKER_FILE" ] && do_rm "$d" && note removed "$(basename "$d")"; done
    say "done" "removed $CHANGED item(s)"; return 0
  fi
  say info "harness: $HARNESS"
  say info "environment: $ENV_KIND"
  update_checkout
  if [ -d "$STABLE" ] && [ ! -L "$STABLE" ] && [ "$(realpath_f "$STABLE")" = "$HARNESS" ]; then note ok "stable path (managed clone)"
  else ensure_link "$STABLE" "$HARNESS" "stable path"; fi
  if confined; then check_shared_tools; else ensure_runtime; ensure_npm_globals; fi
  ensure_link "$BIN_LINK" "$HARNESS/bin/uskn-harness" "executable"
  ensure_link "$LOOP_LINK" "$HARNESS/bin/uskn-loop" "loop runner"
  for d in $(own_skills); do
    name="$(basename "$d")"
    if left_out_skill "$d"; then remove_link "$SKILLS_DIR/$name" "skill $name (admin environment only)"
    else ensure_link "$SKILLS_DIR/$name" "$d" "skill $name"; fi
  done
  prune_stale_skill_links
  for d in $(own_plugins); do
    name="$(basename "$d")"
    if left_out_plugin "$d"; then remove_link "$SKILLS_DIR/$name" "plugin $name (admin environment only)"
    else ensure_link "$SKILLS_DIR/$name" "$d" "plugin $name"; fi
  done
  if confined; then remove_notify_commands; else ensure_notify_commands; fi
  ensure_link "$SCHEMA_LINK" "$HARNESS/schemas/uskn" "openspec schema uskn"
  if confined; then ensure_shared_skills; else ensure_third_party; fi
  prune_session_state
  prune_openspec_skills
  ensure_openspec_user_layer
  ensure_user_settings
  ensure_managed_file "$HARNESS/templates/user/CLAUDE.md" "$CLAUDE_DIR/CLAUDE.md" "user CLAUDE.md"
  ensure_notify_agents
  finish_sync
}

check_link() { # target source label  (doctor)
  case "$(link_status "$1" "$2")" in
    ok) note ok "$3" ;;
    missing) note warn "$3: missing (run uskn-harness sync)" ;;
    update) note warn "$3: stale symlink (run uskn-harness sync)" ;;
    rewrite) note warn "$3: links by $(readlink "$1"), not the relative path through the stable path (run uskn-harness sync)" ;;
    conflict-real) note warn "$3: $1 is a real directory or file (chezmoi-managed copy? sync skips it)" ;;
    conflict-foreign) note fail "$3: $1 points outside the harness ($(readlink "$1"))" ;;
  esac
}
# check_skill_dir_links (doctor): every symlink directly under ~/.claude/skills that the checks above do not cover. A
# dangling one is skipped by Claude Code; an absolute one points at nothing once ~/.claude is copied to another HOME
# or a container. One warn per link at most: a dangling link is not also reported as absolute.
check_skill_dir_links() {
  local l name t reported
  reported=" $(own_plugins | while read -r l; do basename "$l"; done | tr '\n' ' ') $(own_skills | while read -r l; do basename "$l"; done | tr '\n' ' ') $(stale_skill_links | while read -r l; do basename "$l"; done | tr '\n' ' ') "
  for l in "$SKILLS_DIR"/*; do
    [ -L "$l" ] || continue
    name="$(basename "$l")"; t="$(readlink "$l")"
    if [ ! -e "$l" ]; then
      case "$reported" in *" $name "*) ;; *) note warn "dangling skill link $name -> $t (Claude Code skips it; remove it or restore its target)" ;; esac
    else
      case "$t" in /*) note warn "skill link $name -> $t is absolute: copied to another HOME or a container, it points at nothing" ;; esac
    fi
  done
}
check_npm_globals() { # doctor: every pinned npm cli, with the installed version when it differs
  have jq || return 0
  local key specs checks root c name want cur bad v
  if ! root="$(npm_root)"; then say stub "pinned npm CLIs not checked"; return 0; fi
  while IFS=$'\t' read -r -u 3 key specs checks; do
    [ -n "$key" ] || continue
    bad=""
    for c in $checks; do
      name="${c%=*}"; want="${c##*=}"
      cur="$(pkg_version "$root" "$name" 2>/dev/null || true)"
      [ "$cur" = "$want" ] || bad="${bad:+$bad, }$name: have '${cur:-none}', want '$want'"
    done
    if [ -z "$bad" ]; then v="${checks%% *}"; note ok "$key ${v##*=}"; else note warn "$key ($bad)"; fi
  done 3< <(npm_pins)
}

check_opsx_commands() { # doctor: ~/.claude/commands/opsx with the marker and every core workflow
  local d="$COMMANDS_DIR/opsx" w missing=""
  if [ ! -d "$d" ]; then note warn "openspec commands opsx: missing $d (run sync)"; return 0; fi
  if [ ! -f "$d/$MARKER_FILE" ]; then note warn "openspec commands opsx: $d is not harness-managed (sync leaves it alone)"; return 0; fi
  for w in $OPSX_WORKFLOWS; do [ -f "$d/$w.md" ] || missing="${missing:+$missing }$w"; done
  if [ -z "$missing" ]; then note ok "openspec commands opsx ($(printf '%s' "$OPSX_WORKFLOWS" | wc -w | tr -d ' ') workflows)"
  else note warn "openspec commands opsx: missing $missing (run sync)"; fi
}

# check_third_party: every deps.json entry with `via` against its pin -- the ref the skills CLI lock records, or
# Impeccable's SKILL.md version -- plus leftover Impeccable agents and the staleness opt-out. Warnings only: sync fixes
# all four; the opt-out is IMPECCABLE_NO_STALENESS_CHECK=1 in the env of ~/.claude/settings.json, which the settings
# fragment carries.
check_third_party() {
  have jq || return 0
  local name source ref have v want f s="$CLAUDE_DIR/settings.json"
  while IFS=$'\t' read -r -u 3 name source ref; do
    [ -n "$name" ] || continue
    if [ ! -e "$SKILLS_DIR/$name" ] && [ ! -L "$SKILLS_DIR/$name" ]; then note warn "third-party $name missing (run sync)"
    elif ! have="$(lock_ref "$name")"; then note warn "third-party $name: not in the skills CLI lock $(skill_lock) (sync leaves it alone)"
    elif [ "$have" = "$ref" ]; then note ok "third-party $name $(short_ref "$ref")"
    else note warn "third-party $name: the lock records $(short_ref "$have"), deps.json pins $(short_ref "$ref") (run sync)"; fi
  done 3< <(skills_cli_entries)
  while IFS= read -r -u 3 name; do
    [ -n "$name" ] || continue
    want="$(deps_get ".skills[\"$name\"].version" '')"
    v="$(skill_version "$SKILLS_DIR/$name/SKILL.md")"
    if [ ! -e "$SKILLS_DIR/$name" ]; then note warn "third-party $name missing (run sync)"
    elif [ -z "$v" ]; then note warn "third-party $name: $SKILLS_DIR/$name/SKILL.md has no version (sync leaves it alone)"
    elif [ "$v" = "$want" ]; then note ok "third-party $name $v"
    else note warn "third-party $name: version $v installed, deps.json pins $want (run sync)"; fi
    while IFS= read -r f; do note warn "$name agent $f is still there (run sync)"; done < <(listed_agents "$name")
    if [ "${IMPECCABLE_NO_STALENESS_CHECK:-}" = 1 ] || { [ -f "$s" ] && jq -e '(.env.IMPECCABLE_NO_STALENESS_CHECK // "") | tostring == "1"' "$s" >/dev/null 2>&1; }; then
      note ok "IMPECCABLE_NO_STALENESS_CHECK=1"
    else note warn "IMPECCABLE_NO_STALENESS_CHECK=1 is not in the env of $s: Impeccable reports DESIGN.md as stale (run uskn-harness sync; the settings fragment carries it)"; fi
  done 3< <(impeccable_entries)
}

# ------------------------------------------------------ Claude Code minimum
# The floor in deps.json (runtimes.claude-code.min_version) is where Claude Code starts reading AGENTS.md in a
# repository without CLAUDE.md. It is a floor only: anything newer is ok, and sync never installs Claude Code.
# Each install is its own line, because the CLI on PATH and a VS Code extension update separately.
is_version() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)+$ ]]; }
version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]; } # <have> <min>
check_claude_install() { # <what> <version> <min> <how to update>
  if version_ge "$2" "$3"; then note ok "Claude Code: $1 is $2 (minimum $3)"
  else note warn "Claude Code: $1 is $2, older than the deps.json minimum $3; $4 (until then, a repository without CLAUDE.md does not get its AGENTS.md read)"; fi
}
check_claude_code() { # doctor: the claude CLI on PATH and the newest VS Code extension in each extensions dir
  have jq || return 0
  local min cli out v dir d best
  min="$(jq -r '.runtimes["claude-code"].min_version // empty' "$HARNESS/deps.json" 2>/dev/null)"
  [ -n "$min" ] || return 0
  if cli="$(command -v claude)"; then
    out="$(claude --version </dev/null 2>&1 | head -n 1)"
    v="${out%% *}"
    if is_version "$v"; then check_claude_install "claude CLI $cli" "$v" "$min" "run claude update"
    else note warn "Claude Code: claude CLI $cli has no readable version; claude --version printed '$out'"; fi
  fi
  for dir in "$HOME/.vscode/extensions" "$HOME/.vscode-server/extensions"; do
    best=""
    for d in "$dir"/anthropic.claude-code-*; do
      [ -d "$d" ] || continue
      v="${d##*/anthropic.claude-code-}"; v="${v%%-*}"
      is_version "$v" || continue
      if [ -z "$best" ] || version_ge "$v" "${best%%$'\t'*}"; then best="$v"$'\t'"$d"; fi
    done
    [ -n "$best" ] && check_claude_install "VS Code extension ${best#*$'\t'}" "${best%%$'\t'*}" "$min" "update the extension in VS Code"
  done
  return 0
}

# ------------------------------------------------------------ doctor: the environment
check_environment() { # the kind, and whether the marker can be trusted (openspec: harness-doctor)
  local f="$HARNESS/.uskn-environment" why="" uid want="${USKN_MARKER_UID:-0}"
  if [ "$ENV_MARKER" = none ]; then note ok "environment: admin (no $f)"; return 0; fi
  [ "$ENV_MARKER" = ok ] || why="its kind is not confined, or it cannot be read"
  # shellcheck disable=SC2012  # one known path; ls -n is the uid on both GNU and BSD, where stat differs
  uid="$(ls -ldn "$f" 2>/dev/null | awk '{print $3}')"
  [ "$uid" = "$want" ] || why="${why:+$why; }owner uid ${uid:-unknown}, not $want"
  if [ -w "$f" ]; then why="${why:+$why; }$(id -un) can write it"; fi
  if [ -n "$why" ]; then note fail "environment: confined, but the marker $f is not trustworthy: $why (the administrator puts it in place, owned by root and read-only)"
  else note ok "environment: confined (marker $f; tools ${ENV_TOOLS:-none}; secrets ${ENV_SECRETS:-none})"; fi
}
check_confined_writes() { # the agent must not be able to rewrite the hooks or the tools they run
  local p bad=""
  for p in "$HARNESS" "$ENV_TOOLS"; do
    if [ -n "$p" ] && [ -w "$p" ]; then bad="${bad:+$bad, }$p"; fi
  done
  if [ -n "$bad" ]; then note fail "confined: $(id -un) can write $bad, so the agent could rewrite the hooks or the tools they run (the terminal base makes them read-only)"
  else note ok "confined: the checkout and the shared tools are read-only for $(id -un)"; fi
}
check_sandbox_exec() { # the confined hooks run repository code under sandbox-exec only
  if [ "$(host_os)" != Darwin ]; then
    note fail "sandbox-exec: not on $(host_os), so the hooks run no repository code here (a Linux confined environment is not supported)"
  elif ! have sandbox-exec; then
    note fail "sandbox-exec missing, so the hooks run no repository code here"
  else note ok "sandbox-exec"; fi
}
check_shared_skills() { # doctor: each third-party skill against the tools record, and its link into the tools dir
  have jq || return 0
  [ -n "$ENV_TOOLS" ] && [ -d "$ENV_TOOLS" ] || return 0
  local name want have src hint
  hint="the administrator runs uskn-harness install-shared $ENV_TOOLS"
  while IFS= read -r -u 3 name; do
    [ -n "$name" ] || continue
    src="$ENV_TOOLS/skills/$name"
    want="$(shared_want skills "$name")"; have="$(shared_have "$ENV_TOOLS" skills "$name")"
    if ! same_pin "$have" "$want"; then
      note warn "third-party $name: the shared tools record has $(jq -r '"\(.ref // "no ref") \(.version // "")"' <<<"${have:-{\}}"), deps.json pins $(jq -r '"\(.ref) \(.version // "")"' <<<"$want") ($hint)"
    elif [ ! -d "$src" ]; then note warn "third-party $name: $src missing ($hint)"
    elif [ "$(realpath_f "$SKILLS_DIR/$name" 2>/dev/null)" != "$(realpath_f "$src")" ]; then
      note warn "third-party $name: $SKILLS_DIR/$name does not point at $src (run uskn-harness sync)"
    else note ok "third-party $name (shared tools)"; fi
  done 3< <(shared_skill_names)
}

# dev_checkout: where the owner works on the harness -- the first line of ~/.config/uskn-harness/dev-checkout (absolute,
# or starting with ~), else ~/repos/uskn-harness. The bootstrap reads the same file (openspec: machine-bootstrap).
dev_checkout() {
  local f="$HOME/.config/uskn-harness/dev-checkout" line="" dev="$HOME/repos/uskn-harness"
  if [ -f "$f" ]; then
    IFS= read -r line < "$f" || true
    line="${line%$'\r'}"
    case "$line" in \~) dev="$HOME" ;; \~/*) dev="$HOME/${line#\~/}" ;; /*) dev="$line" ;; esac
  fi
  printf '%s\n' "$dev"
}
check_dev_checkout() { # doctor, admin: a managed clone left at the stable path while a dev checkout exists elsewhere
  local dev
  dev="$(dev_checkout)"
  [ -d "$STABLE" ] && [ ! -L "$STABLE" ] && [ -d "$STABLE/.git" ] && [ -d "$dev/.git" ] || return 0
  [ "$(realpath_f "$STABLE")" = "$(realpath_f "$dev")" ] && return 0
  note warn "stable path: $STABLE is a managed clone, while the dev checkout is $dev; to work from the dev checkout, replace it by hand: mv $STABLE $STABLE.old && ln -s $dev $STABLE && uskn-harness sync (sync and doctor never replace it)"
}

cmd_doctor() {
  local d name mise node_ver cur
  say info "harness: $HARNESS"
  check_environment
  if [ -d "$STABLE" ] && [ ! -L "$STABLE" ] && [ "$(realpath_f "$STABLE")" = "$HARNESS" ]; then note ok "stable path (managed clone)"
  else check_link "$STABLE" "$HARNESS" "stable path"; fi
  confined || check_dev_checkout
  if confined; then check_shared_tools
  elif stub; then say stub "runtime checks skipped"
  else
    mise="$(mise_bin)"
    if [ -x "$mise" ]; then note ok "mise"; else note warn "mise missing"; fi
    node_ver="$(deps_get '.runtimes.node.version' 24)"
    if [ -x "$mise" ] && cur="$(mise_global_node "$node_ver")"; then note ok "node $cur (mise global)"; else note warn "no mise global node $node_ver: another node may answer outside the checkout (run sync)"; fi
    if have jq; then note ok "jq"; else note warn "jq missing"; fi
  fi
  confined || check_npm_globals
  check_link "$BIN_LINK" "$HARNESS/bin/uskn-harness" "executable"
  check_link "$LOOP_LINK" "$HARNESS/bin/uskn-loop" "loop runner"
  for d in $(own_skills); do left_out_skill "$d" || check_link "$SKILLS_DIR/$(basename "$d")" "$d" "skill $(basename "$d")"; done
  while IFS= read -r d; do
    [ -n "$d" ] && note warn "stale skill link $(basename "$d") -> $(readlink "$d") (the skill left the harness; run uskn-harness sync)"
  done < <(stale_skill_links)
  check_skill_dir_links
  for d in $(own_plugins); do left_out_plugin "$d" || check_link "$SKILLS_DIR/$(basename "$d")" "$d" "plugin $(basename "$d")"; done
  confined || check_notify_commands
  check_link "$SCHEMA_LINK" "$HARNESS/schemas/uskn" "openspec schema uskn"
  check_claude_code
  if have claude && ! stub; then
    for d in $(own_plugins); do
      if claude plugin validate "$d" >/dev/null 2>&1; then note ok "plugin validate $(basename "$d")"; else note fail "plugin validate (claude plugin validate $d)"; fi
    done
  fi
  if confined; then check_shared_skills; else check_third_party; fi
  check_opsx_commands
  check_user_settings
  check_sandbox_deps
  if confined; then check_confined_writes; check_sandbox_exec; fi
  if is_managed_file "$CLAUDE_DIR/CLAUDE.md"; then note ok "user CLAUDE.md"
  elif [ -e "$CLAUDE_DIR/CLAUDE.md" ]; then note warn "user CLAUDE.md exists without the marker (sync will not touch it)"
  else note warn "user CLAUDE.md missing (run sync)"; fi
  say "done" "$FAILS problem(s), $WARNS warning(s)"
  [ "$FAILS" -eq 0 ]
}

# ------------------------------------------------------------ onboard-check
# Read-only report on a product repository: what the harness expects there and what is missing.
# Never writes to the target and never touches the network; exit code is always 0 (openspec: onboard-check).
repo_has_ui() { # <dir>: a UI framework in package.json dependencies
  local f="$1/package.json"
  [ -f "$f" ] || return 1
  if have jq; then jq -e '((.dependencies // {}) + (.devDependencies // {})) | keys | any(. == ("react","react-native","expo","vue","svelte","next"))' "$f" >/dev/null 2>&1
  else grep -qE '"(react|react-native|expo|vue|svelte|next)"[[:space:]]*:' "$f"; fi
}
has_verify() { # <dir>: the verify convention, printed when found
  local d="$1" mk
  for mk in Makefile GNUmakefile; do
    [ -f "$d/$mk" ] && grep -qE '^verify[[:space:]]*:' "$d/$mk" && { printf 'make verify'; return 0; }
  done
  if [ -f "$d/package.json" ]; then
    if { have jq && jq -e '.scripts.verify' "$d/package.json" >/dev/null 2>&1; } || { ! have jq && grep -q '"verify"' "$d/package.json"; }; then
      [ -f "$d/pnpm-lock.yaml" ] && printf 'pnpm run verify' || printf 'npm run verify'
      return 0
    fi
  fi
  return 1
}
# check_claude_md: Claude Code reads AGENTS.md only while none of CLAUDE.md, .claude/CLAUDE.md and CLAUDE.local.md
# exists. A repository needs none of them; one that has CLAUDE.md or .claude/CLAUDE.md must import @AGENTS.md.
check_claude_md() { # <dir>
  local d="$1" rel found="" bad=0
  for rel in CLAUDE.md .claude/CLAUDE.md; do
    [ -f "$d/$rel" ] || continue
    found="${found:+$found, }$rel"
    grep -qF '@AGENTS.md' "$d/$rel" && continue
    note warn "$rel does not import @AGENTS.md, and while it exists AGENTS.md is not read (move its content to AGENTS.md, then delete it)"; bad=1
  done
  if [ -z "$found" ] && [ -f "$d/CLAUDE.local.md" ]; then
    note warn "CLAUDE.local.md stops Claude Code from reading AGENTS.md here (delete CLAUDE.local.md, or set Project instructions in /config to claude-md-and-agents-md)"; bad=1
  fi
  [ "$bad" = 0 ] || return 0
  if [ -n "$found" ]; then note ok "$found -> @AGENTS.md"; else note ok "no CLAUDE.md: AGENTS.md only"; fi
}
cmd_onboard_check() { # <dir>
  local d name cmd n
  d="$(realpath_f "${1:-.}" 2>/dev/null || printf '%s' "${1:-.}")"
  [ -d "$d" ] || { echo "not a directory: $d" >&2; exit 2; }
  say info "repo: $d"
  if [ -f "$d/AGENTS.md" ]; then note ok "AGENTS.md ($(wc -l < "$d/AGENTS.md") lines)"
  else note warn "AGENTS.md missing (the entry point for agents)"; fi
  check_claude_md "$d"
  if [ ! -f "$d/openspec/config.yaml" ]; then note warn "openspec/ missing (run openspec init, then set schema: uskn)"
  elif grep -qE '^schema:[[:space:]]*uskn' "$d/openspec/config.yaml"; then note ok "openspec schema: uskn"
  else note warn "openspec/config.yaml does not set schema: uskn"; fi
  if cmd="$(has_verify "$d")"; then note ok "verify convention ($cmd)"
  else note warn "no verify convention (add a make verify target)"; fi
  if repo_has_ui "$d"; then
    if [ -f "$d/DESIGN.md" ]; then note ok "DESIGN.md"; else note warn "DESIGN.md missing (UI repo; copy templates/repo/DESIGN.md)"; fi
    if [ -f "$d/PRODUCT.md" ]; then note ok "PRODUCT.md"; else note warn "PRODUCT.md missing (UI repo; copy templates/repo/PRODUCT.md)"; fi
  fi
  n=0
  if [ -d "$d/.claude/skills" ]; then
    for name in "$d"/.claude/skills/*; do
      [ -e "$name" ] || continue
      name="$(basename "$name")"
      if [ -e "$SKILLS_DIR/$name" ]; then note warn "project skill $name shadows the user-layer skill of the same name"; n=$((n + 1)); fi
    done
    if [ "$n" -eq 0 ]; then note ok "project skills do not shadow user-layer skills"; fi
  fi
  say "done" "$WARNS item(s) still to do"
  return 0
}

# ------------------------------------------------------------ sandbox-exclude, sandbox-allow-host
# What the sandbox lets out is data, not code (openspec: harness-sync, sandbox-exclude-skill,
# sandbox-allow-host-skill; ADR-0011, ADR-0012): the fragment holds the defaults, the machine overlay what this
# machine adds. sync treats each array as a set, so an added element survives the next sync, and its three-way prune
# takes a removed one out of live. Both commands share overlay_array; only the check of the value differs.
# shellcheck disable=SC2016  # a jq program: its $p is a jq variable
array_in() { [ -f "$1" ] && jqx -r --argjson p "$2" 'getpath($p) // [] | .[]' "$1" 2>/dev/null; } # <settings file> <path>
# fragment_array <path>: the elements of the fragments merged for this machine (common, kind, OS), before the overlay.
# These are the defaults: --list marks them fragment, and --remove refuses them.
fragment_array() {
  local w
  w="$(mktemp -d)" || return 1
  settings_compose "$w" >/dev/null && array_in "$w/base.json" "$1"
  rm -rf "$w"
}
# overlay_array <command> <path as a JSON array> list|add|remove [value]
overlay_array() {
  local name="$1" path="$2" mode="$3" value="${4:-}" w e defaults
  if [ "$mode" = list ]; then
    defaults="$(fragment_array "$path")"
    array_in "$SETTINGS_FILE" "$path" | while IFS= read -r e; do
      if printf '%s\n' "$defaults" | grep -qxF -- "$e"; then printf '%-9s %s\n' fragment "$e"
      elif array_in "$SETTINGS_OVERLAY" "$path" | grep -qxF -- "$e"; then printf '%-9s %s\n' machine "$e"
      else printf '%-9s %s\n' live "$e"; fi
    done
    return 0
  fi
  if [ -e "$SETTINGS_OVERLAY" ] && ! is_json_object "$SETTINGS_OVERLAY"; then
    echo "$name: $SETTINGS_OVERLAY is not a JSON object; fix it first" >&2; return 1
  fi
  if [ "$mode" = remove ] && fragment_array "$path" | grep -qxF -- "$value"; then
    echo "$name: '$value' is a default in the settings fragments (templates/user/settings*.json); removing it needs a pull request to the harness" >&2
    return 2
  fi
  w="$(mktemp -d)"
  if [ -e "$SETTINGS_OVERLAY" ]; then cp "$SETTINGS_OVERLAY" "$w/overlay.json"; else echo '{}' > "$w/overlay.json"; fi
  # shellcheck disable=SC2016  # jq programs: their $p and $v are jq variables
  if [ "$mode" = remove ]; then
    jqx --argjson p "$path" --arg v "$value" 'if getpath($p) then setpath($p; getpath($p) - [$v]) else . end' "$w/overlay.json" > "$w/new.json"
  else
    jqx --argjson p "$path" --arg v "$value" 'setpath($p; (getpath($p) // []) | if index($v) then . else . + [$v] end)' "$w/overlay.json" > "$w/new.json"
  fi
  mkdir -p "$(dirname "$SETTINGS_OVERLAY")"
  if [ -e "$SETTINGS_OVERLAY" ] && same_json "$SETTINGS_OVERLAY" "$w/new.json"; then note ok "overlay: $SETTINGS_OVERLAY"
  elif write_json_atomic "$SETTINGS_OVERLAY" "$w/new.json"; then note updated "overlay: $SETTINGS_OVERLAY ($mode '$value')"
  else note fail "overlay: could not write $SETTINGS_OVERLAY"; rm -rf "$w"; return 1; fi
  rm -rf "$w"
  ensure_user_settings
  [ "$FAILS" -eq 0 ]
}

cmd_sandbox_exclude() {
  local mode=add pattern=""
  case "${1:-}" in
    --list) mode=list ;;
    --remove) mode=remove; pattern="${2:-}" ;;
    *) pattern="${1:-}" ;;
  esac
  if [ "$mode" != list ] && confined; then
    echo "sandbox-exclude: this is a confined environment: sync does not carry sandbox-loosening values from the machine overlay, and the terminal base decides which commands run outside the sandbox" >&2
    return 2
  fi
  if [ "$mode" != list ]; then
    case "$(printf '%s' "$pattern" | tr -d '[:space:]')" in
      '' | '*') echo "sandbox-exclude: give a pattern such as 'terraform *'; an empty one or a bare * would take every command out of the sandbox" >&2; return 2 ;;
    esac
  fi
  overlay_array sandbox-exclude '["sandbox","excludedCommands"]' "$mode" "$pattern"
}

cmd_sandbox_allow_host() {
  local mode=add host=""
  case "${1:-}" in
    --list) mode=list ;;
    --remove) mode=remove; host="${2:-}" ;;
    *) host="${1:-}" ;;
  esac
  if [ "$mode" != list ] && confined; then
    echo "sandbox-allow-host: this is a confined environment: sync does not carry sandbox-loosening values from the machine overlay, and the terminal base decides which hosts the sandbox reaches" >&2
    return 2
  fi
  if [ "$mode" != list ]; then
    case "$host" in
      *'*'*) echo "sandbox-allow-host: '$host' has a *; WebFetch(domain:*) already lets the sandbox reach every host that is not this machine's own" >&2; return 2 ;;
      https://* | */*) echo "sandbox-allow-host: '$host' is a URL; give the host name only, such as gl.example.test" >&2; return 2 ;;
    esac
    [ -n "$(printf '%s' "$host" | tr -d '[:space:]')" ] || { echo "sandbox-allow-host: give a host name such as gl.example.test" >&2; return 2; }
  fi
  overlay_array sandbox-allow-host '["sandbox","network","allowedDomains"]' "$mode" "$host"
}

main() {
  ORIG_ARGV=("$@")
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    -h | --help | help | "") usage; [ -n "$cmd" ] && exit 0 || exit 2 ;;
    sync | init | doctor | onboard-check) ;;
    sandbox-exclude) resolve_harness_dir; environment_read; cmd_sandbox_exclude "$@"; exit $? ;;
    sandbox-allow-host) resolve_harness_dir; environment_read; cmd_sandbox_allow_host "$@"; exit $? ;;
    install-shared) resolve_harness_dir; cmd_install_shared "$@"; exit $? ;;
    print-settings) [ $# -eq 0 ] || { echo "print-settings takes no argument" >&2; exit 2; }
                    resolve_harness_dir; environment_read; cmd_print_settings; exit $? ;;
    *) echo "unknown command: $cmd" >&2; usage >&2; exit 2 ;;
  esac
  local target=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      --remove) REMOVE=1 ;;
      --tools) TOOLS=1 ;;
      --no-pull) NO_PULL=1 ;;
      -*) echo "unknown option: $1" >&2; exit 2 ;;
      *) if [ "$cmd" = onboard-check ] && [ -z "$target" ]; then target="$1"; else echo "unexpected argument: $1" >&2; exit 2; fi ;;
    esac
    shift
  done
  if [ "$TOOLS" = 1 ]; then
    case "$cmd" in sync | init) ;; *) echo "--tools is only valid with sync" >&2; exit 2 ;; esac
    [ "$REMOVE" = 1 ] && { echo "--tools cannot be combined with --remove" >&2; exit 2; }
  fi
  resolve_harness_dir
  environment_read
  case "$cmd" in
    sync | init) cmd_sync ;;
    doctor) cmd_doctor ;;
    onboard-check) cmd_onboard_check "${target:-.}" ;;
  esac
}
[ "${USKN_HARNESS_SOURCED:-0}" = 1 ] || main "$@"
