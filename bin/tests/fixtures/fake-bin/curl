#!/usr/bin/env bash
# Stand-in for curl in bin/tests/third-party.bats: records the URL in $FAKE_LOG and copies $FAKE_ZIP to the -o path.
out="" url=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift ;;
    -*) ;;
    *) url="$1" ;;
  esac
  shift
done
printf 'curl %s -> %s\n' "$url" "$out" >> "${FAKE_LOG:-/dev/null}"
[ -n "$out" ] && [ -f "${FAKE_ZIP:-}" ] || { echo "fake curl: no FAKE_ZIP or -o" >&2; exit 22; }
cp "$FAKE_ZIP" "$out"
