#!/usr/bin/env bash
# Stand-in for `gh` in bin/tests/uskn-cc-catchup.bats. Every call is appended to $FAKE_DIR/gh.log. The repository is
# acme/harness; `issue list` prints $FAKE_DIR/issues.json (default []); `issue create` records its title, body, and
# label as $FAKE_DIR/created/<n>.title, .body, .label and prints the new issue's URL.
set -u
printf '%s\n' "$*" >> "$FAKE_DIR/gh.log"
case "${1:-} ${2:-}" in
  "repo view") echo "acme/harness" ;;
  "label create") ;;
  "issue list") cat "$FAKE_DIR/issues.json" 2>/dev/null || echo "[]" ;;
  "issue create")
    mkdir -p "$FAKE_DIR/created"
    n=$(($(find "$FAKE_DIR/created" -name '*.title' | wc -l) + 1))
    shift 2
    while [ $# -gt 0 ]; do
      case "$1" in
        --title) printf '%s' "$2" > "$FAKE_DIR/created/$n.title"; shift 2 ;;
        --body-file) cp "$2" "$FAKE_DIR/created/$n.body"; shift 2 ;;
        --label) printf '%s' "$2" > "$FAKE_DIR/created/$n.label"; shift 2 ;;
        *) shift ;;
      esac
    done
    echo "https://github.com/acme/harness/issues/$((100 + n))" ;;
  *) echo "fake gh: unsupported: $*" >&2; exit 2 ;;
esac
