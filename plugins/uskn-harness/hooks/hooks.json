{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/session-start.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/session-baseline.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/journal-recent.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/openspec/changes/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/grilling-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/openspec/changes/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/grilling-guard.sh"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/grilling-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/bash-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/textlint-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Write(**/*.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/terms-check.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/textlint-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Edit(**/*.md)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/terms-check.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/verify-gate.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/journal-update.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/scripts/journal-end.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
